{% include 'defaults/head.twig' %}

<main class="main" id="main-content">

	{% if is_active_sidebar('widget-area-header-ad') %}
		<div class="top-advertisement">
			{{ sidebar.get_widgetarea('widget-area-header-ad')|raw }}
		</div>
	{% endif %}

	{% block header %}{% endblock %}

	<div class="section section--no-top">
		<div class="container">
			<div class="md:flex md:flex-nowrap md:gap-6">
				<div class="layout-large">
					<div class="section-wrapper">
						{% block content %}{% endblock %}
					</div>
				</div>
				<div class="layout-small">
					<aside class="sidebar" data-module="sticky-advertisement">
						<h2 class="screen-reader-text">
							{{ __('Additional', 'impact-investor') }}
						</h2>
						<div class="section-wrapper">
							{% block sidebar %}{% endblock %}
						</div>
					</aside>
				</div>
			</div>
		</div>
	</div>
</main>

{% include 'defaults/footer.twig' %}
