{% extends 'layouts/sidebar-layout.twig' %}
{% set object = objects|first %}
{% set title = object.get_title() %}
{% set terms = object.get_terms('category') %}

{% block content %}

	<article class="section">
		{% set authors = object.get_authors() %}
		{% include 'styleguide/components/article-header.twig' with {
			title: title,
			terms: terms ? terms|map(term => {
				name: term.get_name(),
				url: term.get_permalink(),
			}),
			date: object.get_date_i18n(get_option('date_format')),
			datetime: object.get_date_i18n('Y-m-d'),
			authors: authors ? authors|map(author => {
				name: author.get_title(),
				url: author.get_permalink(),
			}),
		} %}

		<div class="entry-content">
			{{ object.get_content()|raw }}
		</div>
	</article>

	{% include 'styleguide/components/comments/comment-section.twig' %}
{% endblock %}

{% block sidebar %}
	<div class="section">
		{% include 'styleguide/components/latest-articles.twig' with {
			heading: __('Latest news', 'impact-investor'),
			objects: latest_articles ? latest_articles|map(post => {
				title: post.get_title(),
				url: post.get_permalink(),
				date: post.get_date_i18n('H:i'),
				datetime: post.get_date_i18n('H:i'),
			}),
			button_text: __('More articles', 'impact-investor'),
			button_link: get_post_type_archive_link('post'),
			style: 'dark',
		} %}
	</div>
{% endblock %}
