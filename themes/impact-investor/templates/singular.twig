{% extends 'layouts/full-width.twig' %}
{% set object = objects|first %}
{% set title = object.get_title() %}

{% block content %}
	<div class="section">
		<div class="entry-content">
			<h1 class="entry-title">{{ title|raw }}</h1>
			{{ object.get_content()|raw }}
		</div>
	</div>

	{% include 'styleguide/components/comments/comment-section.twig' %}
{% endblock %}
