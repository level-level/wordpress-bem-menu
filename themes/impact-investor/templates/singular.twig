{% extends 'layouts/sidebar-layout.twig' %}
{% set object = objects|first %}
{% set title = object.get_title() %}
{% set terms = object.get_terms('category') %}

{% block content %}
	<article class="section section--large">
		<div class="entry-content">


			{% if terms %}
				<span class="screen-reader-text">
					{{ __('Posted in category:', 'impact-investor') }}
				</span>
				{% include 'styleguide/components/badges/list-badges.twig' with {
					badges: terms ? terms|map(term => {
						name: term.get_name(),
						url: term.get_permalink(),
					}),
				} %}
			{% endif %}

			<h1 class="entry-title">{{ title|raw }}</h1>
			{{ object.get_content()|raw }}
		</div>
	</article>

	{% include 'styleguide/components/comments/comment-section.twig' %}
{% endblock %}

{% block sidebar %}
	{% include 'styleguide/components/tabbed-posts.twig' %}
{% endblock %}
