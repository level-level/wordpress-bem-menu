{% extends 'layouts/sidebar-layout.twig' %}
{% set object = objects|first %}
{% set terms = object.get_terms('category') %}

{% block content %}
	<article class="section">
		{% set authors = object.get_authors() %}
		{% include 'styleguide/components/article-header.twig' with {
			title: object.get_title(),
			terms: terms ? terms|map(term => {
				name: term.get_name(),
				url: term.get_permalink(),
			}),
			date: object.get_date_i18n(get_option('date_format')),
			datetime: object.get_date_i18n('Y-m-d'),
			authors: authors ? authors|map(author => {
				name: author.get_title(),
				url: author.get_permalink(),
			}),
		} %}

		<div class="entry-content">
			{{ object.get_content()|raw }}
		</div>
	</article>

	{% include 'styleguide/components/comments/comment-section.twig' %}
{% endblock %}

{% block sidebar %}
	{% if is_active_sidebar('widget-area-article') %}
		{{ sidebar.get_widgetarea('widget-area-article')|raw }}
	{% endif %}
{% endblock %}
