{% if title or image or content or button %}
	<div class="cta">
		<div aria-hidden='true' class="cta__image-container">
			{{ image|raw }}
		</div>
		<div class="cta__content-container">
			<h3 class="cta__title">{{ title }}</h3>
			<div class="cta__text">{{ content|raw }}</div>

			{% include 'styleguide/components/buttons/button-link.twig' with {
				text: button.title,
				url: button.url,
				class: 'btn--action',
				is_external: button.target ? true
			} %}

		</div>
	</div>
{% endif %}
