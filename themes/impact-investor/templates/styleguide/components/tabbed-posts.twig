<div class="section">
	<div class="tablist" data-module="tabs">
		<ul class="tab-list" role="tablist">

			{% if most_read_articles %}
				<li role="presentation" class="tab-list__item">
					<a role="tab" href="#most-read" id="tab1" class="tab-list__link" aria-selected="true">
						{{ __('Most read', 'impact-investor') }}
					</a>
				</li>
			{% endif %}

			<li role="presentation" class="tab-list__item">
				<a role="tab" href="#latest_articles" id="tab2" class="tab-list__link" tabindex="-1" {{ not most_read_articles ? 'aria-selected="true"' }}>
					{{ __('Latest articles', 'impact-investor') }}
				</a>
			</li>
		</ul>

		{# Dummy for now #}
		{% set posts = [
			{
				title: 'Stephen Brenninkmeijer talks COP26, impact investing and faith',
				url: '#',
				date: 'Oct 19, 21',
				datetime: '2021-10-19',
			},
			{
				title: 'Gates Foundation and partners launch Digital Agri Hub',
				url: '#',
				date: 'Oct 20, 21',
				datetime: '2021-10-20',
			},
			{
				title: 'Founding Managing Director NAB: ‘I want to create impact at scale’',
				url: '#',
				date: 'Oct 16, 21',
				datetime: '2021-10-16',
			},
			{
				title: 'Impact investing in Benelux ‘in hockey stick phase’',
				url: '#',
				date: 'Oct 14, 21',
				datetime: '2021-10-14',
			},
			{
				title: 'Invest International: ‘Dutch solutions for global challenges’',
				url: '#',
				date: 'Oct 3, 21',
				datetime: '2021-10-3',
			}
		] %}

		{% if most_read_articles %}
			<div id="most-read" class="tab-list__section" aria-hidden="false">
				{% include 'styleguide/components/most-read-articles.twig' with {
					objects: most_read_articles,
				} %}
			</div>
		{% endif %}

		<div id="latest_articles" class="tab-list__section" {{ not most_read_articles ? 'aria-hidden="false"' }}>
			{% include 'styleguide/components/latest-articles.twig' with {
				objects: posts,
			} %}
		</div>
	</div>
</div>
