{% if objects %}
	<ul class="list-bordered">
		{% set date_format = get_option('date_format') %}

		{% for object in objects %}
			<li class="list-bordered__item">
				{% include 'styleguide/components/list-item.twig' with {
					title: object.get_title(),
					url: object.get_permalink(),
					date: object.get_date_i18n(date_format),
					datetime: object.get_date_i18n('Y-m-d'),
				} %}
			</li>
		{% endfor %}
	</ul>
{% endif %}
