{% if badges %}
	<ul class="flex flex-wrap gap-1">
		{% for badge in badges %}
			<li>
				{% include 'styleguide/components/badges/badge.twig' with {
					title: not loop.last and not badge.url ? badge.name ~ ',' : badge.name,
					url: badge.url,
				} %}
			</li>
		{% endfor %}
	</ul>
{% endif %}
