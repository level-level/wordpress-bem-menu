<div class="article-header">

	{% if terms %}
		<div class="article-header__terms">
			{% include 'styleguide/components/post-terms.twig' with {
				terms: terms,
			} %}
		</div>
	{% endif %}

	<div class="article-header__title">
		<h1>{{ title|raw }}</h1>
	</div>

	{% if authors or date and datetime %}
		<div class="article-header__meta">
			<div class="row">

				{% if authors %}
					<div class="col-auto">
						<span class="screen-reader-text">
							{{ __('Written by:', 'impact-investor') }}
						</span>
						<ul class="list-authors">
							{% for object in authors %}
								<li class="list-authors__item">
									{% include 'styleguide/components/buttons/button-link.twig' with {
										text: not loop.last ? object.name ~ ',' : object.name,
										url: object.url,
										class: 'btn--secondary btn--no-padding',
									} %}
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

				{% if date and datetime %}
					<div class="col-auto">
						<span class="screen-reader-text">{{ __('Published on:', 'impact-investor') }}</span>
						<time datetime="{{ datetime|raw }}">{{ date|raw }}</time>
					</div>
				{% endif %}

			</div>
		</div>
	{% endif %}
</div>
