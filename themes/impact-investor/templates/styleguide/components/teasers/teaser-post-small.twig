<div class="teaser-post teaser-post--small">

	{% if image %}
		<div class="teaser-post__thumbnail hidden-sm">
			{{ image|raw }}
		</div>
	{% endif %}

	<div class="teaser-post__inner">
		<div class="group group--small">

			<div class="group__item">
				<div class="row row--space-between row--nowrap row--align-center">
					<div class="col-auto">
						{% if terms %}
							<span class="screen-reader-text">
								{{ __('Posted in category:', 'impact-investor') }}
							</span>
							{% include 'styleguide/components/badges/list-badges.twig' with {
								badges: terms,
							} %}
						{% endif %}
					</div>
					<div class="col-auto">
						<div class="teaser-post__date">
							<span class="screen-reader-text">{{ __('Published on:', 'impact-investor') }}</span>
							<time datetime="{{ datetime|raw }}">{{ date|raw }}</time>
						</div>
					</div>
				</div>
			</div>

			<div class="group__item hidden-xs visible-sm">
				<div class="row row--space-between row--nowrap">
					<div class="col-auto">
						<div class="group--small">
							<div class="group__item">
								<h2 class="teaser-post__title">
									<a href="{{ url }}" class="teaser-post__link">
										{{ title|raw }}
									</a>
								</h2>
							</div>

							{% if excerpt %}
								<div class="group__item">
									<div class="teaser-post__excerpt">
										{{ excerpt|raw }}
									</div>
								</div>
							{% endif %}
						</div>
					</div>

					{% if image_square %}
						<div class="col-auto col--shrink-0">
							<div class="teaser-post__thumbnail-s visible-sm">
								{{ image_square|raw }}
							</div>
						</div>
					{% endif %}
				</div>
			</div>

			<div class="group__item hidden-sm">
				<div class="group--small">
					<div class="group__item">
						<h2 class="teaser-post__title">
							<a href="{{ url }}" class="teaser-post__link">
								{{ title|raw }}
							</a>
						</h2>
					</div>

					{% if excerpt %}
						<div class="group__item">
							<div class="teaser-post__excerpt">
								{{ excerpt|raw }}
							</div>
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
	<div class="teaser-post__footer">
		<div class="row row--space-between row--nowrap row--align-center">
			<div class="col-auto">
				{% if author.name %}
					<span class="screen-reader-text">
						{{ __('Written by:', 'impact-investor') }}
					</span>
					{% include 'styleguide/components/buttons/button-link.twig' with {
						text: author.name,
						url: author.url,
						class: 'btn--link btn--author',
					} %}
				{% endif %}
			</div>
			<div class="col-auto">
				<div class="row row--space-between row--nowrap row--align-center">
					<div class="col-auto">
						{% include 'styleguide/components/social-share-button.twig' with {
							show_button_title: true,
							post_title: title,
							url: url,
						} %}
					</div>

					{% if comments > 0 %}
						<div class="col-auto">
							{% include 'styleguide/components/buttons/button-link.twig' with {
								text: _n('%s comment', '%s comments', comments, 'impact-investor')|format(comments),
								url: url ~ '#comments',
								class: 'btn--link',
								aria_label: __('View comments in this article', 'impact-investor'),
								icon: 'icon-whatsapp',
								icon_left: true,
							} %}
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</div>
