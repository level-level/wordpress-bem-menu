<div class="teaser-post teaser-post--wide">

	{# Mobile only #}
	<div class="sm:hidden">
		<div class="teaser-post__inner">
			<div class="flex items-center gap-6">
				<div class="grow">
					{% include 'styleguide/components/teasers/post/header.twig' with {
						useH3: useH3,
						url: url,
						title: title,
						terms: terms,
					} only %}
				</div>

				{% if image_square %}
					<div class="shrink-0">
						<div class="teaser-post__square-thumbnail">
							{{ image_square|raw }}
						</div>
					</div>
				{% endif %}
			</div>
		</div>
	</div>

	{# Tablet >= #}
	<div class="hidden sm:block">
		<div class="teaser-post__inner">
			<div class="flex gap-6">
				<div class="grow">
					{% include 'styleguide/components/teasers/post/header.twig' with {
						useH3: useH3,
						url: url,
						title: title,
						terms: terms,
						date: date,
						datetime: datetime,
						date_full: date_full,
					} only %}

					{% if excerpt %}
						<div class="teaser-post__excerpt">
							{{ excerpt|raw }}
						</div>
					{% endif %}
				</div>

				{% if image %}
					<div class="shrink">
						<div class="teaser-post__thumbnail">
							{{ image|raw }}
						</div>
					</div>
				{% endif %}

			</div>
		</div>

		{% include 'styleguide/components/teasers/post/footer.twig' with {
			title: title,
			authors: authors,
			comments: comments,
			url: url,
		} %}
	</div>
</div>
