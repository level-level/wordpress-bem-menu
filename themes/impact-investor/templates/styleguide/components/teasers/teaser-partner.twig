<div class="teaser-partner">
	<div class="teaser-partner__inner">
		<div class="row row--spacing row--sm-nowrap">

			<div class="col-12 col-sm-auto col--sm-shrink-0 col--sm-order-2">
				<div class="teaser-partner__thumbnail">
					{% if image %}
						{{ image|raw }}
					{% endif %}
				</div>
			</div>

			<div class="col-12 col-sm-auto">
				<div class="group group--small">
					<div class="group__item">
						<h3 class="teaser-partner__title">
							{{ title|raw }}
						</h3>
					</div>

					{% if excerpt %}
						<div class="group__item">
							{{ excerpt|raw }}
						</div>
					{% endif %}

					<div class="group__item">
						{% include 'styleguide/components/buttons/button-link.twig' with {
							text: __('View partner', 'impact-investor'),
							url: url,
							class: 'btn--tertiary',
							aria_label: __('View partner, %s', 'impact-investor')|format(title),
							icon: 'icon-arrow-right',
							icon_left: true,
							highlight_icon: true,
						} %}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
