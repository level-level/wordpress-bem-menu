<div class="teaser-post teaser-post--medium">

	{% if image %}
		<div class="teaser-post__thumbnail">
			{{ image|raw }}
		</div>
	{% endif %}

	<div class="teaser-post__inner">
		{% include 'styleguide/components/teasers/post/header.twig' with {
			useH3: useH3,
			url: url,
			title: title,
			terms: terms,
			date: date,
			datetime: datetime,
			date_full: date_full,
		} only %}

		{% if excerpt %}
			<div class="teaser-post__excerpt">
				{{ excerpt|raw }}
			</div>
		{% endif %}
	</div>

	{% include 'styleguide/components/teasers/post/footer.twig' with {
		title: title,
		authors: authors,
		comments: comments,
		url: url,
	} only %}
</div>
