<div class="teaser-comment">
	<div class="teaser-comment__header">
		<div class="row row--space-between row--align-center row--nowrap">
			<div class="col-auto">
				<div class="teaser-comment__author">
					{{ author }}
				</div>
			</div>
			<div class="col-auto">
				<div class="teaser-comment__meta">
					{{ time|raw }}
				</div>
			</div>
		</div>
	</div>
	<div class="teaser-comment__content">
		<p>
			{{ content }}
		</p>
	</div>
</div>
