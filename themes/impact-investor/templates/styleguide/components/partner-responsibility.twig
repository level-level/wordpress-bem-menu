{% if partner %}
	<div class="layout-small-responsibility">
		<div class="responsibility {{ sticky ? 'responsibility--sticky' }}" {{ sticky ? 'aria-hidden="true"' }}>
			<div class="section-wrapper">
				<div class="section">
					{% if partner %}
						<div class="responsibility-text">
							<div class="responsibility-text__inner">
								<p><strong>{{ partner|raw }}</strong> {{ __('is responsible for the contents of this page.', 'impact-investor') }}</p>
								<p>{{ __('Any statements or opinions expressed within the content are solely the authors and do not reflect the opinions and beliefs of the website or its affiliates.', 'impact-investor') }}</p>
							</div>
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endif %}
