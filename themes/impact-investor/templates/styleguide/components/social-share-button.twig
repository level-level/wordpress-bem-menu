{% set trigger = uniqid('js-share-dropdown-') %}
{% set target = uniqid('social-share-dropdown__block-') %}
<div
	class="social-share-dropdown"
	data-module="socialShareDropdown"
	data-config='{
		"trigger": ".{{ trigger }}",
		"target": ".{{ target }}"
}'>
	{% include 'styleguide/components/buttons/button-element.twig' with {
		text: show_button_title ? __('Share', 'impact-investor'),
		aria_expanded_support: true,
		class: 'btn--link js-share-dropdown ' ~ trigger,
		aria_label: __('Share, open share options', 'impact-investor'),
		aria_expanded_text: __('Share, close share options', 'impact-investor'),
		aria_collapsed_text: __('Share, open share options', 'impact-investor'),
		icon: 'icon-whatsapp',
		icon_left: true,
	} %}
	<div class="social-share-dropdown__block {{ target }}" aria-hidden="true">
		<div class="social-share-dialog">
			<div class="group">
				<div class="group__item">
					<div class="row row--nowrap row--space-between row--align-center">
						<div class="col-auto">
							{{ __('Share via', 'impact-investor') }}
						</div>
						<div class="col-auto">
							{% include 'styleguide/components/buttons/button-element.twig' with {
								aria_expanded_support: true,
								class: 'btn--link js-share-dropdown ' ~ trigger,
								aria_label: __('Close share options', 'impact-investor'),
								icon: 'icon-close',
							} %}
						</div>
					</div>
				</div>
				<div class="group__item">
					{% include 'styleguide/components/social-share.twig' with {
						dialog: true,
						share_url: url,
						post_title: post_title,
						socials: [
							{
								title: 'Twitter',
								type: 'twitter',
							},
							{
								title: 'Facebook',
								type: 'facebook',
							},
							{
								title: 'LinkedIn',
								type: 'linkedin',
							},
							{
								title: 'E-mail',
								type: 'email',
							},
						]
					} %}
				</div>
			</div>
		</div>
	</div>
</div>
