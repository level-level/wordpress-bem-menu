{% if object.has_comments_enabled() %}
	<div class="section">
		<div class="flex flex-col gap-3">

			{% set comment_count = object.get_comments_count() %}
			{% if comment_count > 0 %}
				<div id="comments">
					<div class="comments-area">
						<div class="comments-area__header">
							<h2 class="comments-area__title">
								{{ _n('%s Comment', '%s Comments', comment_count, 'impact-investor')|format(comment_count) }}
							</h2>
						</div>
						<ol class="list-comments">
							{{ object.get_comments() }}
						</ol>
					</div>
				</div>
			{% endif %}

			<div class="comment-form-container">
				{{ object.get_comment_form() }}
			</div>
		</div>
	</div>
{% endif %}
