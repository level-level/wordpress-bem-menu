{% if title or label %}
	<div class="author-header">
		<div class="flex flex-col gap-3">

			{% if label %}
				<ul class="flex gap-1">
					<li>
						<div class="badge badge--rich">
							{{ label|raw }}
						</div>
					</li>
				</ul>
			{% endif %}

			{% if title %}
				<h1 class="rich-title">{{ title|raw }}</h1>
			{% endif %}
		</div>
	</div>
{% endif %}
