{% if title or image or content or button %}
	<div class="newsletter">
		<div class="newsletter__inner">
			<div class="group">

				{% if title %}
					<div class="group__item">
						<h3 class="newsletter__title">
							{{ title }}
						</h3>
					</div>
				{% endif %}

				{% if image %}
					<div class="group__item">
						<div class="newsletter__thumbnail">
							{{ image|raw }}
						</div>
					</div>
				{% endif %}

				{% if content %}
					<div class="group__item">
						<div class="newsletter__content">
							{{ content|raw }}
						</div>
					</div>
				{% endif %}

				{% if button.title and button.url %}
					<div class="group__item">
						{% include 'styleguide/components/buttons/button-link.twig' with {
							text: button.title,
							url: button.url,
							class: 'btn--primary btn--full',
							is_external: button.target ? true,
							aria_label: __('Sign up to our weekly newsletter', 'impact-investor'),
						} %}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endif %}
