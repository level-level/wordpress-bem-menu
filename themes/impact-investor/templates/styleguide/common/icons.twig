<div class="section">
	<div class="container">
		<div class="entry-content">
			<div class="grid gap-4 sm:gap-8 grid-cols-1 sm:grid-cols-3">
				{% for name, svg in svg_icons.get_svgs() %}
					<div class="flex items-center gap-4">
						<span class="icon-inline" aria-hidden="true">{{ svg_icons.get(name)|raw }}</span>
						<div class="shrink-0">
							<code>.{{ name }}</code>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</div>
</div>
