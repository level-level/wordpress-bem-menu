{% extends 'layouts/full-width.twig' %}

{% block content %}
	<div class="section">
		<div class="container">
			<h1>{{ _n('%s result found', '%s results found', found_posts, 'impact-investor')|format(found_posts) }}</h1>
		</div>
	</div>

	<div class="section">
		<div class="container">
			{% include 'partials/components/search.twig' %}
		</div>
	</div>

	{% if objects %}
		<div class="section">
			<div class="container">
				<h2 class="screen-reader-text">{{ __('Overview of search results', 'impact-investor') }}</h2>
				<ul class="row row--spacing">
					{% for object in objects %}

						{% set image_id = object.get_thumbnail_id() %}
						{% set terms = object.get_terms('category') %}
						{% set author = object.get_author() %}

						<li class="col-12">
							{% include 'styleguide/components/teasers/teaser-post-small.twig' with {
								image: image_id ? wp_get_attachment_image(image_id, 'large'),
								image_square: image_id ? wp_get_attachment_image(image_id, 'thumbnail'),
								title: object.get_title(),
								url: object.get_permalink(),
								excerpt: object.get_excerpt(),
								date: object.get_date_i18n(date_format),
								datetime: object.get_date_i18n('Y-m-d'),
								terms: terms ? terms|map(term => {
									name: term.get_name(),
								}),
								author: {
									name: author.get_display_name(),
									url: get_author_posts_url(author.get_id())
								},
							} %}
						</li>
					{% endfor %}
				</ul>
			</div>
		</div>

		<div class="section">
			<div class="container">
				{% include 'partials/components/pagination.twig' %}
			</div>
		</div>
	{% else %}
		<div class="section">
			<div class="container">
				<p>{{ __('No search results found', 'impact-investor') }}</p>
			</div>
		</div>
	{% endif %}
{% endblock %}
