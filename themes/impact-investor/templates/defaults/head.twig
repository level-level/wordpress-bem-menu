<!doctype html>
<html class="no-js" {{ language_attributes() }}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">

		<meta name="theme-color" content="#a2c3d6" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#191919" media="(prefers-color-scheme: dark)">

		<link rel="preload" as="font" href="{{ assets.get_assets_directory_url() }}/fonts/impact-investor.ttf" type="font/ttf" crossorigin="anonymous">

		{# Instantly set the theme style class on the <html> element based on the localStorage #}
		<script>
			try {
				if ( localStorage.getItem( 'theme-style' ) === null ) {
					localStorage.setItem( 'theme-style', 'system' );
				}
				var preference = localStorage.getItem( 'theme-style' );
				document.documentElement.classList.add( 'theme-' + preference );
			} catch (e) {}
		</script>

		{{ wp_head() }}
	</head>
	<body {{ body_class() }}>

	{% include 'defaults/header.twig' %}
