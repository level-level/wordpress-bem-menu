{% set objects = block.get_posts() %}
{% set columns = data.columns %}

{# Based on column amount (2 or 3) use a different teaser and column width #}
{% if columns is same as('2') %}
	{% set class = 'col-sm-6' %}
	{% set teaser_size = 'medium' %}
	{% set row = 'row--spacing' %}
{% elseif columns is same as('3') %}
	{% set class = 'col-lg-4' %}
	{% set teaser_size = 'small' %}
	{% set row = 'row--sm-spacing' %}
{% endif %}

{% if objects %}
	<div class="align{{ align }}">

		<ul class="row {{ row }}">
			{% set date_format = get_option('date_format') %}

			{% for object in objects %}

				{% set image_id = object.get_thumbnail_id() %}
				{% set terms = object.get_terms('category') %}
				{% set authors = object.get_authors() %}

				<li class="col-12 {{ class }}">
					{% include 'styleguide/components/teasers/teaser-post-' ~ teaser_size ~ '.twig' with {
						image: image_id ? wp_get_attachment_image(image_id, 'large'),
						image_square: image_id ? wp_get_attachment_image(image_id, 'thumbnail'),
						title: object.get_title(),
						url: object.get_permalink(),
						excerpt: object.get_excerpt(),
						date: object.get_date_i18n(date_format),
						datetime: object.get_date_i18n('Y-m-d'),
						terms: terms ? terms|map(term => {
							name: term.get_name(),
						}),
						authors: authors ? authors|map(author => {
							name: author.get_title(),
							url: author.get_permalink(),
						}),
						comments: object.get_comments_count(),
					} %}
				</li>
			{% endfor %}
		</ul>
	</div>
{% else %}
	{% include 'partials/components/gb-placeholder.twig' with {
		required_fields: ['Articles']
	} %}
{% endif %}
