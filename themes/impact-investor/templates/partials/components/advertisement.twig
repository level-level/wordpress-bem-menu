{% if slot %}
	<div class="advertisement" aria-hidden="true">
		<div class="advertisement__element">

			{% if is_admin() %}
				<div class="advertisement__selected">
					{{ __('Selected slot: <strong>%s</strong>', 'impact-investor')|format(slot)|raw }}
				</div>
			{% endif %}

			<div class="ii-message" data-slot="{{ slot }}"></div>
		</div>
	</div>
{% endif %}
