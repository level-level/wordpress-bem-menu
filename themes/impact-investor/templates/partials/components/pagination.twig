{# Settings pagination for archives and search #}
{# For available args see: https://developer.wordpress.org/reference/functions/paginate_links/ #}

{% set args = {
		'type': 'list',
		'mid_size': 1,
		'before_page_number': '<span class="screen-reader-text">' ~ __('Page', 'impact-investor') ~ '</span>',
		'prev_text': '<span class="pagination__icon pagination__icon--prev" aria-hidden="true"></span><span class="screen-reader-text">' ~ __('Previous page', 'impact-investor') ~ '</span>',
		'next_text': '<span class="pagination__icon pagination__icon--next" aria-hidden="true"></span><span class="screen-reader-text">' ~ __('Next page', 'impact-investor') ~ '</span>'
	}
%}

{% set pagination = paginate_links(args) %}
{% if pagination %}
	<div class="section">
		<nav class="pagination" aria-label="{{ __('Pagination', 'impact-investor') }}">
			<h2 class="screen-reader-text">{{ __('Pagination', 'impact-investor') }}</h2>
			{{ pagination|raw }}
		</nav>
	</div>
{% endif %}
