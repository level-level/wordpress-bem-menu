{% set radio_id = uniqid('radio') %}

<div class="dark-mode" data-module="displayOptions">
	<div class="dark-mode__title">
		{{ __('Display preferences', 'impact-investor') }}
	</div>
	<div class="dark-mode__dropdown">
		<div class="dark-mode__inner">
			<ul class="list-dark-mode" data-module="themeSelection">
				<li class="list-dark-mode__item">
					<input type="radio" name="theme-choice-{{ radio_id }}" value="system" id="theme-system-{{ radio_id }}" checked>
					<label for="theme-system-{{ radio_id }}">{{ __('System (device settings)', 'impact-investor') }}</label>
				</li>
				<li class="list-dark-mode__item">
					<input type="radio" name="theme-choice-{{ radio_id }}" value="light" id="theme-light-{{ radio_id }}">
					<label for="theme-light-{{ radio_id }}">{{ __('Light theme', 'impact-investor') }}</label>
				</li>
				<li class="list-dark-mode__item">
					<input type="radio" name="theme-choice-{{ radio_id }}" value="dark" id="theme-dark-{{ radio_id }}">
					<label for="theme-dark-{{ radio_id }}">{{ __('Dark theme', 'impact-investor') }}</label>
				</li>
			</ul>
		</div>
	</div>
</div>
