<div
	class="header-search"
	data-module="headerSearch"
	data-config='{
		"trigger": ".js-header-search",
		"target": ".header-search__dropdown",
		"focusInput": true,
		"disableScroll": true
}'>
	{% include 'styleguide/components/buttons/button-element.twig' with {
		text: __('Search', 'impact-investor'),
		aria_expanded_support: true,
		class: 'btn--secondary btn--search js-header-search js-header-search-open',
		aria_label: __('Open search', 'impact-investor'),
		aria_expanded_text: __('Close search', 'impact-investor'),
		aria_collapsed_text: __('Open search', 'impact-investor'),
		icon: 'icon-search',
		icon_left: true,
	} %}
	<div class="header-search__dropdown" aria-hidden="true">
		<div class="container">
			<div class="row row--align-center row--nowrap">
				<div class="col-auto col--grow-1">
					{% include 'partials/components/search.twig' with {
						in_header: true,
					} %}
				</div>
				<div class="col-auto">
					{% include 'styleguide/components/buttons/button-element.twig' with {
						text: '',
						aria_expanded_support: true,
						class: 'btn--secondary btn--search js-header-search',
						aria_label: __('Close search', 'impact-investor'),
						icon: 'icon-close',
					} %}
				</div>
			</div>
		</div>
	</div>
	<div class="header-search__backdrop"></div>
</div>
