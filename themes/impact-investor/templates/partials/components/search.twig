{% set random_id = uniqid('searchbar-') %}
<form class="search-component" method="get" action="{{ get_home_url() }}" role="search">
	<div class="row row--align-center row--spacing">
		<div class="col-12 col-sm-auto col--sm-grow-1">
			<label for="{{ random_id }}" class="screen-reader-text">{{ __('Search', 'impact-investor') }}</label>
			<input
				type="search"
				name="s"
				value="{{ the_search_query() }}"
				id="{{ random_id }}"
				placeholder="{{ __('Search by keyword', 'impact-investor') }}"
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
			>
		</div>
		<div class="col-12 col-sm-auto">
			{% include 'styleguide/components/buttons/button-element.twig' with {
				text: __('Search', 'impact-investor'),
				class: 'btn--primary btn--full',
				icon: 'search',
				icon_left: true,
				type: 'submit'
			} %}
		</div>
	</div>
</form>
