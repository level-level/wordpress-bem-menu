<div class="oembed-component" data-module="oembed" data-source="consent_embed_{{ source }}" data-type="{{ embed_type }}" data-disable-notice="{{ disable_notice }}">
	<div class="oembed-component__content">
		<div class="oembed-placeholder">
			<div class="oembed-placeholder__content">
				<p>{{ notice_text }}</p>
				{% include "styleguide/components/buttons/button-element.twig" with {
					text: button_text,
					class: 'btn--primary js-consent-button',
				} %}
			</div>
		</div>
	</div>

	<template>
		{% if embed_type == 'video' %}
			{% include 'partials/components/oembeds/oembed-video.twig' %}
		{% elseif embed_type == 'audio' %}
			{% include 'partials/components/oembeds/oembed-audio.twig' %}
		{% else %}
			{{ html|raw }}
		{% endif %}
	</template>
</div>
