{% extends 'layouts/sidebar-layout.twig' %}
{% set object = objects|first %}
{% set title = object.get_title() %}

{% block content %}
	<h1 class="screen-reader-text">{{ title|raw }}</h1>
	<div class="section">
		<div class="entry-content">
			{{ object.get_content()|raw }}
		</div>
	</div>
{% endblock %}

{% block sidebar %}
	{% include 'styleguide/components/tabbed-posts.twig' with {
		latest: latest_articles,
		most_read: most_read_articles,
	} %}

	<div class="section">
		{% include 'partials/components/advertisement.twig' %}
	</div>

	<div class="section">
		Jobs
	</div>

	<div class="section">
		{% include 'partials/components/advertisement.twig' %}
	</div>

	{% set newsletter = options.newsletter %}
	<div class="section">
		{% include 'styleguide/components/newsletter.twig' with {
			title: newsletter.title,
			image: newsletter.image ? wp_get_attachment_image(newsletter.image, 'medium'),
			content: newsletter.content,
			button: {
				title: newsletter.button.title,
				url: newsletter.button.url,
				target: newsletter.button.target,
			}
		} %}
	</div>
{% endblock %}
