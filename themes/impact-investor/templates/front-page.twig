{% extends 'layouts/sidebar-layout.twig' %}
{% set object = objects|first %}
{% set title = object.get_title() %}

{% block content %}
	<h1 class="screen-reader-text">{{ title|raw }}</h1>
	<div class="section">
		<div class="entry-content">
			{{ object.get_content()|raw }}
		</div>
	</div>
{% endblock %}

{% block sidebar %}
	{% include 'styleguide/components/tabbed-posts.twig' with {
		latest: latest_articles,
		most_read: most_read_articles,
	} %}
{% endblock %}
