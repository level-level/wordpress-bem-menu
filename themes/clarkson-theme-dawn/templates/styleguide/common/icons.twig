<div class="section">
	<div class="container">
		<div class="entry-content">
			<div class="row row--spacing">
				{% for icon in icons %}
					<div class="col-12 col-sm-4">
						<div class="row">
							<div class="col-1">
								<span class="{{ icon }}" aria-hidden="true"></span>
							</div>
							<div class="col-auto">
								<code>.{{ icon }}</code>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</div>
</div>
