{#
	Button link

	Options:
	text: text in the button
	url: link of the button
	is_external: bool - if the link links to an external source
	class: button class
	aria_label: aria label on the link
	icon: class of an icon
	icon_left: bool
#}

{% if is_external %}
	{% set external = 'target="_blank" rel="noopener"' %}
{% endif %}

{% if aria_label %}
	{% set aria_label = 'aria-label="%s"'|format(aria_label) %}
{% endif %}

{% if url %}
	<a href="{{ url|raw }}" class="btn {{ class|raw }}" {{ external|raw }} {{ aria_label|raw }}>
		{% if icon and icon_left %}
			<span class="btn__icon">
				<span class="icon {{ icon|raw }}" aria-hidden="true"></span>
			</span>
		{% endif %}

		{% if text %}
			<span class="btn__text">
				{{ text|raw }}

				{% if is_external %}
					<span class="screen-reader-text">{{ __('Opens in a new window', 'clarkson-theme-dawn') }}</span>
				{% endif %}
			</span>
		{% endif %}

		{% if icon and not icon_left %}
			<span class="btn__icon">
				<span class="icon {{ icon|raw }}" aria-hidden="true"></span>
			</span>
		{% endif %}
	</a>
{% endif %}
