<div
	class="header-search"
	data-module="toggle"
	data-config='{
		"trigger": ".js-header-search",
		"target": ".header-search__dropdown",
		"focusInput": true
}'>
	{% include 'styleguide/components/buttons/button-element.twig' with {
		text: '',
		aria_expanded_support: true,
		class: 'btn--primary btn--search js-header-search',
		aria_label: __('Open search', 'clarkson-theme-dawn'),
		aria_expanded_text: __('Open search', 'clarkson-theme-dawn'),
		aria_collapsed_text: __('Close search', 'clarkson-theme-dawn'),
		icon: 'icon-search',
		icon_left: false,
	} %}
	<div class="header-search__dropdown" aria-hidden="true">
		<div class="container">
			{% include 'partials/components/search.twig' %}
		</div>
	</div>
</div>
