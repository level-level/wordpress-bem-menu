{% extends 'layouts/sidebar-layout.twig' %}
{% set object = objects|first %}

{% if not feature_manager.is_enabled(constant('FEATURE_DISABLE_CATEGORY_TAXONOMY', feature_manager)) %}
	{% set categories = object.get_terms('category') %}
{% endif %}

{% if feature_manager.is_enabled(constant('FEATURE_ENABLE_GENRE_TAXONOMY', feature_manager)) %}
	{% set genres = object.get_terms('fdmg_genre') %}
{% endif %}

{% if feature_manager.is_enabled(constant('FEATURE_ENABLE_SECTION_TAXONOMY', feature_manager)) %}
	{% set sections = object.get_terms('fdmg_section') %}
{% endif %}

{% block header_advertisement_area %}
	{% if is_active_sidebar('widget-area-article-header-ad') %}
		<div class="top-advertisement">
			{{ sidebar.get_widgetarea('widget-area-article-header-ad')|raw }}
		</div>
	{% endif %}
{% endblock %}

{% block content %}
	{% if is_singular('post') %}
		{% include 'partials/tag-manager/article-terms.twig' with {
			genres: genres,
			sections: sections,
		} only %}
	{% endif %}
	<article class="section" {{ datalayer.get_config(object, 'PAGEVIEW') }}>
		{% set authors = object.get_authors() %}
		{% include 'styleguide/components/article-header.twig' with {
			title: object.get_title(),
			categories: categories ? categories|map(category => {
				name: category.get_name(),
				url: category.get_permalink(),
			}),
			genres: genres ? genres|map(genre => {
				name: genre.get_name(),
				url: genre.get_permalink(),
			}),
			sections: sections ? sections|map(section => {
				name: section.get_name(),
				url: section.get_permalink(),
			}),
			date: object.get_publish_date(),
			authors: authors ? authors|map(author => {
				name: author.get_title(),
				location: author.get_location(),
				url: author.get_permalink(),
			}),
			notice: object.get_old_article_message()
		} %}

		<div class="entry-content">
			{{ object.get_content()|raw }}
		</div>
	</article>

	{% include 'styleguide/components/comments/comment-section.twig' %}
{% endblock %}

{% block sidebar %}
	{% if is_active_sidebar('widget-area-article') %}
		{{ sidebar.get_widgetarea('widget-area-article')|raw }}
	{% endif %}
{% endblock %}

{% block offset %}
	{% include 'styleguide/components/social-share.twig' with {
		sticky: true,
		article_id: object.get_id(),
	} %}
{% endblock %}
