{% extends 'layouts/sidebar-layout.twig' %}
{% set object = objects|first %}
{% set content = object.get_content() %}

{% block header_advertisement_area %}
	{% if is_active_sidebar('widget-area-partner-header-ad') %}
		<div class="top-adver">
			{{ sidebar.get_widgetarea('widget-area-partner-header-ad')|raw }}
		</div>
	{% endif %}
{% endblock %}

{% block content %}
	<div class="section" {{ datalayer.get_config(object, 'PAGEVIEW') }}>
		{% include 'styleguide/components/article-header.twig' with {
			title: object.get_title(),
			label: _x('Partner', 'Label', 'fdmg-labels'),
		} %}

		{% if content %}
			<div class="entry-content">
				{{ content|raw }}
			</div>
		{% endif %}
	</div>
{% endblock %}

{% block sidebar %}
	<div class="section">
		{% set image_id = object.get_thumbnail_id() %}
		{% include 'styleguide/components/bio.twig' with {
			subtitle: object.get_subtitle(),
			excerpt: object.get_excerpt(),
			logo: image_id ? wp_get_attachment_image(image_id, 'medium', false, {alt: ''}),
		} only %}
	</div>

	{% if is_active_sidebar('widget-area-partner') %}
		{{ sidebar.get_widgetarea('widget-area-partner')|raw }}
	{% endif %}
{% endblock %}

{% block responsibility %}
	{% include 'styleguide/components/partner-responsibility.twig' with {
		partner: object.get_title(),
	} %}
{% endblock %}
