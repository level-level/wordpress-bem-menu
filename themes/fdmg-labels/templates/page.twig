{% extends 'layouts/sidebar-layout.twig' %}
{% set object = objects|first %}

{% block header_advertisement_area %}
	{% if is_active_sidebar('widget-area-page-header-ad') %}
		<div class="top-adver">
			{{ sidebar.get_widgetarea('widget-area-page-header-ad')|raw }}
		</div>
	{% endif %}
{% endblock %}

{% block content %}
	<div class="section" {{ datalayer.get_config(object, 'PAGEVIEW') }}>
		{% include 'styleguide/components/article-header.twig' with {
			title: object.get_title(),
		} %}

		<div class="entry-content">
			{{ object.get_content()|raw }}
		</div>
	</div>
{% endblock %}

{% block sidebar %}
	{% if is_active_sidebar('widget-area-page') %}
		{{ sidebar.get_widgetarea('widget-area-page')|raw }}
	{% endif %}
{% endblock %}
