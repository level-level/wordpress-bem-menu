<p>
	<strong>{{ _x('Time:', 'Selligent', 'fdmg-labels') }} </strong> {{ status.time }} {{ _x('(server time)', 'Selligent', 'fdmg-labels') }}
</p>

<p>
	<h2>{{ _x('Articles', 'Selligent', 'fdmg-labels') }}</h2>
	<table>
		<thead>
			<tr>
				<th>{{ _x('Code', 'Selligent', 'fdmg-labels') }}</th>
				<th>{{ _x('Message', 'Selligent', 'fdmg-labels') }}</th>
				<th>{{ _x('Body', 'Selligent', 'fdmg-labels') }}</th>
			</tr>
		</thead>
		<tbody>
			{% for article in status.articles %}
			<tr>
				<td>{{ article.code }}</td>
				<td>{{ article.message }}</td>
				<td>{{ article.body|json_encode }}</td>
			<tr>
			{% endfor %}
		</tbody>
	</table>
</p>

{% if status.newsletter %}
	<p>
		{{ _x('Registering the newsletter resulted in the following error:', 'Selligent', 'fdmg-labels') }}<br>
		[{{ status.newsletter.code }}] {{ status.newsletter.message }}<br>
		{{ status.newsletter.body|json_encode }}
	</p>
{% else %}
	<p>
		{{ _x('Since there was an error while registering the articles, the newsletter registration was canceled.', 'Selligent', 'fdmg-labels') }}
	</p>
{% endif %}

{% if status.send %}
	<p>
		{{ _x('Sending the newsletter resulted in the following error:', 'Selligent', 'fdmg-labels') }}<br>
		[{{ status.newsletter.code }}] {{ status.newsletter.message }}<br>
		{{ status.newsletter.body|json_encode }}
	</p>
{% else %}
	<p>
		{{ _x('Since there was an error while registering the newsletter, the newsletter sending was canceled.', 'Selligent', 'fdmg-labels') }}
	</p>
{% endif %}
