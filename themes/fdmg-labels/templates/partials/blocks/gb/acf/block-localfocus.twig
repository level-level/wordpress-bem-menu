{% set embed_id = data.embed_id %}
{% set title = data.title %}
{% set pointer_events = is_admin() ? 'none' : 'auto' %}

{% if embed_id %}
	<div class="{{ align }}" data-name="{{ block.name }}">
		<iframe title="{{ title }}" frameborder="0" style="width:100%;height:550px;overflow:hidden;background-color:#fff;pointer-events:{{ pointer_events }};" src="https://localfocuswidgets.net/{{ embed_id }}"></iframe>
	</div>
{% else %}
	{% include 'partials/components/block-placeholder.twig' with {
		required_fields: [
			_x('Embed ID', 'Block', 'fdmg-labels-admin'),
			_x('Title', 'Block', 'fdmg-labels-admin')
		]
	} %}
{% endif %}
