{% set embed_id = data.embed_id %}

{% if embed_id %}
	<div class="{{ align }}" data-name="{{ block.name }}">
		<iframe frameborder="0" style="width:100%;height:550px;overflow:hidden" src="https://localfocuswidgets.net/{{ embed_id }}"></iframe>
	</div>
{% else %}
	{% include 'partials/components/block-placeholder.twig' with {
		required_fields: [_x('Embed ID', 'Block', 'fdmg-labels-admin')]
	} %}
{% endif %}
