{% set cta = data.cta %}

{% if cta.title and cta.content and cta.button.title and cta.button.url %}
	{% include 'styleguide/components/cta-component.twig' with {
		title: cta.title,
		image: cta.image ? wp_get_attachment_image(cta.image, 'medium'),
		content: cta.content,
		button: {
			title: cta.button.title,
			url: cta.button.url,
			target: cta.button.target
		}
	} %}
{% else %}
	{% include 'partials/components/block-placeholder.twig' with {
		required_fields: [_x('Title', 'Block', 'fdmg-labels'), _x('Image', 'Block', 'fdmg-labels'), _x('Text', 'Block', 'fdmg-labels'), _x('Button link', 'Block', 'fdmg-labels')]
	} %}
{% endif %}
