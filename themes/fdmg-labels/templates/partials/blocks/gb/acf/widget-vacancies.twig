{% set objects = block.get_posts() %}

{% if objects %}
	<div class="{{ align }}" data-name="{{ block.name }}">
		{% include 'styleguide/components/list-component.twig' with {
			heading: _x('Jobs', 'Block', 'fdmg-labels'),
			objects: objects ? objects|map(vacancy => {
				title: vacancy.get_title(),
				url: vacancy.get_permalink(),
				date: vacancy.get_publish_date(),
			}),
			style: 'light',
		} %}
	</div>
{% else %}
	{% include 'partials/components/block-placeholder.twig' with {
		required_fields: [_x('Vacancies', 'Block', 'fdmg-labels-admin')]
	} %}
{% endif %}
