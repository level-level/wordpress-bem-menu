{% set title = data.title|default(_x('Our partners', 'Block', 'fdmg-labels')) %}
{% set objects = data.partners %}

{% if objects %}
	<div class="{{ align }}" data-name="{{ block.name }}">
		<div class="flex flex-col gap-3">
			<h2>{{ title|raw }}</h2>
			<ul class="flex flex-col gap-6">
				{% for object in objects %}
					{% set image_id = object.get_thumbnail_id() %}
					<li>
						{% include 'styleguide/components/teasers/teaser-partner.twig' with {
							image: image_id ? wp_get_attachment_image(image_id, 'medium'),
							title: object.get_title(),
							url: object.get_permalink(),
							excerpt: object.get_excerpt(),
						} %}
					</li>
				{% endfor %}
			</ul>
		</div>
	</div>
{% else %}
	{% include 'partials/components/block-placeholder.twig' with {
		required_fields: [_x('Partners', 'Block', 'fdmg-labels-admin')]
	} %}
{% endif %}
