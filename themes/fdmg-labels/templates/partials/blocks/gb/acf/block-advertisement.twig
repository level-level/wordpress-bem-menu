{% set enable_advertisements = options.enable_advertisements %}
{% set slot = data.advertisement_slot %}

{% if slot and enable_advertisements %}
	<div class="align{{ align }}">
		{% include 'partials/components/advertisement.twig' with {
			slot: slot
		} only %}
	</div>
{% elseif not enable_advertisements %}
	{% include 'partials/components/gb-placeholder.twig' with {
		text: _x('Advertisements are currently <strong>disabled</strong>. Enable them in the theme options.', 'Block', 'fdmg-labels'),
	} %}
{% else %}
	{% include 'partials/components/gb-placeholder.twig' with {
		required_fields: ['Slot']
	} %}
{% endif %}
