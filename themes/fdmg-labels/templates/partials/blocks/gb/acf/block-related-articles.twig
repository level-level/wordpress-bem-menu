{% set title = data.title|default(_x('Related news', 'Block', 'fdmg-labels')) %}
{% set objects = block.get_posts() %}

{% if objects %}
	<div class="align{{ align }}" data-name="{{ block.name }}">
		<div class="relative border-b-2 border-secondary-400 bg-secondary-200 dark:bg-base-600 dark:border-transparent">

			<h2 class="font-body-bold text-lg text-primary p-3 border-b border-secondary-400 dark:border-base-800 sm:text-[24px] sm:py-3 sm:px-6">{{ title|raw }}</h2>

			<ul class="py-3">
				{% for object in objects %}
					<li class="sm:mx-6">

						{% set image_id = object.get_thumbnail_id() %}
						{% set terms = object.get_terms('category') %}

						{% include 'styleguide/components/teasers/teaser-post-inline.twig' with {
							image: image_id ? wp_get_attachment_image(image_id, 'medium'),
							image_square: image_id ? wp_get_attachment_image(image_id, 'thumbnail'),
							title: object.get_title(),
							url: object.get_permalink(),
							terms: terms ? terms|map(term => {
								name: term.get_name(),
							}),
							useH3: true,
							is_last_item: loop.last,
						} %}
					</li>
				{% endfor %}
			</ul>
		</div>
	</div>
{% else %}
	{% include 'partials/components/gb-placeholder.twig' with {
		required_fields: [_x('Articles', 'Block', 'fdmg-labels')]
	} %}
{% endif %}
