{% set latest_articles = block.get_latest_articles() %}
{% set most_read_articles = block.get_most_read_articles() %}

{% if latest_articles or most_read_articles %}
	<div class="{{ align }}" data-name="{{ block.name }}">
		<h3 class="sr-only">{{ _x('Latest and most read articles', 'Screen reader text', 'fdmg-labels') }}</h3>
		{% include 'styleguide/components/tabbed-posts.twig' with {
			latest: latest_articles,
			most_read: most_read_articles,
			latest_posts_title: data.latest_posts_title,
			most_read_posts_title: data.most_read_posts_title,
			show_latest_articles_first: data.show_latest_articles_first,
		} %}
	</div>
{% endif %}
