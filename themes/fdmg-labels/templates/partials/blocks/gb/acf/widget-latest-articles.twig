{% set objects = block.get_latest_articles() %}

{% if objects %}
	<div class="{{ align }}" data-name="{{ block.name }}">
		{% include 'styleguide/components/list-component.twig' with {
			heading: _x('Latest news', 'Block', 'fdmg-labels'),
			objects: objects ? objects|map(post => {
				title: post.get_alternative_title()|default(post.get_title()),
				url: post.get_permalink(),
				date: post.get_date_i18n('H:i'),
				datetime: post.get_date_i18n('H:i'),
			}),
			button_text: _x('More articles', 'Block', 'fdmg-labels'),
			button_link: get_post_type_archive_link('post'),
			style: 'dark',
		} %}
	</div>
{% endif %}
