{% set newsletter = options.newsletter %}
{{ dump( newsletter )}}
{% if newsletter.title or newsletter.image or newsletter.content or newsletter.button %}
	<div class="align{{ align }}" data-name="{{ block.name }}">
		{% include 'styleguide/components/newsletter.twig' with {
			title: newsletter.title,
			image: newsletter.image ? wp_get_attachment_image(newsletter.image, 'medium'),
			content: newsletter.content,
			button: {
				title: newsletter.button.title,
				url: newsletter.button.url,
				target: newsletter.button.target,
			}
		} %}
	</div>
{% endif %}
