<div class="container">
	<div class="flex items-center justify-between">
		<div class="sm:hidden">
			{% if has_nav_menu(constant('PRIMARY_NAV', navigation)) %}
				{% include 'partials/components/header/header-menu.twig' with {
					use_compact_header: true,
				} %}
			{% endif %}
		</div>
		<div class="grow sm:grow-0">
			{% include 'partials/components/header/logo.twig' with {
				use_compact_header: true,
			} %}
		</div>

		{% if has_nav_menu(constant('PRIMARY_NAV', navigation)) %}
			<div class="hidden sm:block sm:ml-auto">
				{% include 'partials/components/header/header-menu.twig' %}
			</div>
		{% endif %}

		<div class="hidden shrink-0 sm:block">
			<div class="flex items-center gap-2 flex-nowrap">
				<ul class="flex items-center gap-2">
					<li>
						{% include 'partials/components/header/header-search.twig' with {
							show_button_label: use_compact_header ? false : true,
						} %}
					</li>

					{% set subscribe = options.subscribe_button %}
					{% if subscribe.url %}
						<li>
							{% include 'styleguide/components/buttons/button-link.twig' with {
								text: _x('Subscribe', 'Subscribe', 'fdmg-labels'),
								url: subscribe.url,
								class: 'btn-primary',
								is_external: subscribe.target ? true,
							} %}
						</li>
					{% endif %}

					<li>
						{% include 'partials/components/header/header-profile.twig' with {
							button_class: use_compact_header ? 'btn-profile' : 'btn-header',
						} %}
					</li>
				</ul>
			</div>
		</div>
	</div>
</div>
