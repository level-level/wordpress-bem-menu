<div class="flex items-center bg-secondary-200 h-[var(--header-height)] dark:bg-base-600 sm:bg-base-50 sm:h-[var(--header-top-height)] sm:dark:bg-base-700">
	<div class="container">
		<div class="flex items-center justify-between">
			<div class="sm:hidden">
				{% if has_nav_menu('primary_navigation') %}
					{% include 'partials/components/header/header-menu.twig' %}
				{% endif %}
			</div>
			<div class="grow sm:grow-0">
				{% include 'partials/components/header/logo.twig' %}
			</div>

			<div class="hidden shrink-0 sm:block">
				<div class="flex items-center gap-2">
					{% set newsletter = options.newsletter %}
					{% if newsletter.button.title and newsletter.button.url %}
						{% include 'styleguide/components/buttons/button-link.twig' with {
							text: newsletter.button.title,
							url: newsletter.button.url,
							class: 'btn--primary',
							is_external: newsletter.button.target ? true,
							aria_label: _x('Sign up to our weekly newsletter', 'Newsletter', 'fdmg-labels'),
						} %}
					{% endif %}
					<ul class="flex flex-wrap items-center">
						<li class="flex border-l border-[rgb(0,0,0,0.1)] h-[var(--header-top-height)] justify-center dark:border-base-400">
							{% include 'partials/components/header/header-profile.twig' with {
								button_class: use_compact_header ? 'btn--profile' : 'btn--header',
							} %}
						</li>
						<li class="flex border-l border-r border-[rgb(0,0,0,0.1)] h-[var(--header-top-height)] justify-center dark:border-base-400 ">
							{% include 'partials/components/header/header-search.twig' with {
								show_button_label: use_compact_header ? false : true,
							} %}
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>

{% if has_nav_menu('primary_navigation') %}
	<div class="hidden sm:block">
		<div class="flex items-center bg-secondary-300 h-[var(--menu-height)] dark:bg-base-400">
			<div class="container">
				{% include 'partials/components/header/header-menu.twig' %}
			</div>
		</div>
	</div>
{% endif %}
