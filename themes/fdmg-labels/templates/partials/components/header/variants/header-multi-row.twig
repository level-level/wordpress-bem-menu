<div data-component="header-multi-row" class="flex items-center bg-secondary-100 h-header-height dark:bg-base-600 sm:bg-base-50 sm:h-[var(--header-top-height)] sm:dark:bg-base-700 theme-bnr:bg-base-800 sm:theme-bnr:bg-base-50 theme-fd:bg-paper-200 theme-fd:border-b theme-fd:border-paper-300 theme-fd:dark:bg-base-600 theme-fd:dark:border-paper-600">
	<div class="container">
		<div class="flex items-center justify-between theme-bnr:justify-normal sm:theme-bnr:justify-between">
			<div class="sm:hidden">
				{% if has_nav_menu(constant('PRIMARY_NAV', navigation)) %}
					{% include 'partials/components/header/header-menu.twig' %}
				{% endif %}
			</div>
			<div class="grow sm:grow-0 theme-bnr:grow-0">
				{% include 'partials/components/header/logo.twig' %}
			</div>

			<div class="hidden theme-energeia:block theme-pensioen-pro:block sm:hidden sm:theme-energeia:hidden sm:theme-pensioen-pro:hidden">
				{% include 'partials/components/header/header-profile.twig' %}
			</div>

			<div class="hidden shrink-0 sm:block">
				<div class="flex items-center gap-2">
					{% set newsletter = options.newsletter %}
					{% if newsletter.newsletter_button_in_header and newsletter.button.title and newsletter.button.url %}
						{% include 'styleguide/components/buttons/button-link.twig' with {
							text: newsletter.button.title,
							url: newsletter.button.url,
							class: 'btn-primary',
							is_external: newsletter.button.target ? true,
							aria_label: _x('Sign up to our weekly newsletter', 'Newsletter', 'fdmg-labels'),
						} %}
					{% endif %}
					{% set subscribe = options.subscribe_button %}
					{% if subscribe.url and options.subscribe_button_in_header %}
						{% include 'styleguide/components/buttons/button-link.twig' with {
							text: _x('Subscribe', 'Subscribe', 'fdmg-labels'),
							url: subscribe.url,
							class: 'btn-primary theme-energeia:hocus:text-base-50 theme-pensioen-pro:hocus:text-base-50 focus:outline-base-50 theme-pensioen-pro:bg-secondary-400 theme-pensioen-pro:border-secondary-400 theme-pensioen-pro:text-base-600 theme-pensioen-pro:hocus:bg-transparent theme-pensioen-pro:dark:bg-primary-300 theme-pensioen-pro:dark:border-primary-300 theme-fd:bg-orange theme-fd:border-orange theme-bnr:bg-primary theme-bnr:text-base-800 theme-bnr:hocus:bg-transparent theme-bnr:hocus:text-base-50 theme-bnr:border-primary',
							is_external: subscribe.target ? true,
						} %}
					{% endif %}
					<ul class="flex flex-wrap items-center">
						<li class="flex border-l border-[rgb(0,0,0,0.1)] h-[var(--header-top-height)] justify-center dark:border-base-400">
							{% include 'partials/components/header/header-profile.twig' with {
								button_class: use_compact_header ? 'btn-profile' : 'btn-header',
							} %}
						</li>
						<li class="flex border-l border-r border-[rgb(0,0,0,0.1)] h-[var(--header-top-height)] justify-center dark:border-base-400 ">
							{% include 'partials/components/header/header-search.twig' with {
								show_button_label: use_compact_header ? false : true,
							} %}
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>

{% if has_nav_menu(constant('PRIMARY_NAV', navigation)) %}
	<div class="hidden sm:block">
		<div class="flex items-center bg-secondary-300 h-[var(--menu-height)] dark:bg-base-400 theme-bnr:bg-base-800 theme-fd:bg-paper-200 theme-fd:dark:bg-base-600">
			<div class="container">
				{% include 'partials/components/header/header-menu.twig' %}
			</div>
		</div>
	</div>
{% endif %}
