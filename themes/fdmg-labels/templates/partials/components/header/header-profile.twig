{% set trigger = uniqid('js-header-profile-') %}
{% set target = uniqid('header-profile__dropdown-') %}

<div
	class="header-profile"
	data-module="header-profile"
	data-config='{
		"trigger": ".{{ trigger }}",
		"target": ".{{ target }}"
}'>
	{% include 'styleguide/components/buttons/button-element.twig' with {
		text: '',
		aria_expanded_support: true,
		class: 'btn--profile ' ~ trigger,
		aria_label: _x('Open profile', 'Profile', 'fdmg-labels'),
		aria_expanded_text: _x('Close profile', 'Profile', 'fdmg-labels'),
		aria_collapsed_text: _x('Open profile', 'Profile', 'fdmg-labels'),
		icon: 'user',
		icon_left: true,
	} %}
	<div class="header-profile__dropdown {{ target }}" aria-hidden="true">
		<div class="header-profile__inner">
			{% include 'partials/components/header/header-display-options.twig' %}
		</div>
	</div>
</div>
