{% set trigger = uniqid('js-header-menu-') %}
{% set target = uniqid('header-menu__dropdown-') %}
{% set scrollarea = uniqid('header-menu__inner-') %}
<div
	class="header-menu sm:hidden"
	data-module="header-menu"
	data-config='{
		"trigger": ".{{ trigger }}",
		"target": ".{{ target }}",
		"disableScroll": true,
		"customScrollableElement": ".{{ scrollarea }}",
		"defaultButtonText": "{{ _x('Menu', 'Menu', 'fdmg-labels') }}",
		"closeButtonText": "{{ _x('Close', 'Menu', 'fdmg-labels') }}"
}'>
	{% include 'styleguide/components/buttons/button-element.twig' with {
		text: _x('Menu', 'Menu', 'fdmg-labels'),
		aria_expanded_support: true,
		class: 'btn--menu ' ~ trigger,
		aria_label: _x('Open menu', 'Menu', 'fdmg-labels'),
		aria_expanded_text: _x('Close menu', 'Menu', 'fdmg-labels'),
		aria_collapsed_text: _x('Open menu', 'Menu', 'fdmg-labels'),
		icon: 'menu',
		icon_expanded: 'close',
		icon_left: true,
	} %}
	<div class="header-menu__dropdown {{ target }}" aria-hidden="true">
		<div class="menu-dropdown">
			<div class="menu-dropdown__inner {{ scrollarea }}">
				<div class="menu-dropdown__search">
					<div class="container">
						{% include 'partials/components/search-header.twig' %}
					</div>
				</div>
				<div class="menu-dropdown__body">
					<nav aria-label="{{ wp_get_nav_menu_name('primary_navigation') }}" data-module="primary-nav">
						{{ bem_menu('primary_navigation', 'primary-nav') }}
					</nav>

					<div class="menu-dropdown__item">
						{% include 'partials/components/header/header-display-options.twig' %}
					</div>
				</div>
			</div>

			{% set newsletter = options.newsletter %}
			<div class="menu-dropdown__footer">
				<ul class="flex justify-between h-full flex-nowrap">

					{% if newsletter.button.title and newsletter.button.url %}
						<li class="flex items-center justify-center w-full border-r border-secondary-300 dark:border-base-400 last:border-r-0">
							{% include 'styleguide/components/buttons/button-link.twig' with {
								text: newsletter.button.title,
								url: newsletter.button.url,
								class: 'w-full justify-center h-full !text-base-50 !text-[20px]',
								is_external: newsletter.button.target ? true,
								aria_label: _x('Sign up to our weekly newsletter', 'Newsletter', 'fdmg-labels'),
								icon: 'email',
								icon_left: true,
							} %}
						</li>
					{% endif %}
				</ul>
			</div>
		</div>
	</div>
	<div class="header-menu__backdrop"></div>
</div>

<div class="hidden sm:block">
	<nav aria-label="{{ wp_get_nav_menu_name('primary_navigation') }}" data-module="primary-nav">
		{{ bem_menu('primary_navigation', 'primary-nav') }}
	</nav>
</div>
