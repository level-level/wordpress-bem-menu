{% set trigger = uniqid('js-header-menu-') %}
{% set target = uniqid('js-header-menu-dropdown-') %}
{% set scrollarea = uniqid('js-header-menu-inner-') %}

{% set config = {
	trigger: '.' ~ trigger,
	target: '.' ~ target,
	disableScroll: true,
	customScrollableElement: '.' ~ scrollarea,
	defaultButtonText: _x('Menu', 'Menu', 'fdmg-labels'),
	closeButtonText: _x('Close', 'Menu', 'fdmg-labels'),
} %}
<div
	data-component="header-menu"
	class="relative sm:hidden"
	data-module="header-menu"
	data-config="{{ config|json_encode() }}">

	{% include 'styleguide/components/buttons/button-element.twig' with {
		text: _x('Menu', 'Menu', 'fdmg-labels'),
		aria_expanded_support: true,
		class: 'btn-menu ' ~ trigger,
		aria_label: _x('Open menu', 'Menu', 'fdmg-labels'),
		aria_expanded_text: _x('Close menu', 'Menu', 'fdmg-labels'),
		aria_collapsed_text: _x('Open menu', 'Menu', 'fdmg-labels'),
		icon: 'menu',
		icon_expanded: 'close',
		icon_left: true,
	} %}
	<div class="fixed inset-0 top-[theme(space.admin-bar)] w-[calc(100vw-theme(space.6))] bg-secondary-100 z-10 translate-x-0 visible ease-theme-bezier duration-300 dark:bg-base-600 aria-hidden:invisible aria-hidden:-translate-x-full js-header-menu-dropdown focus-visible:outline-base-50 {{ target }}" aria-hidden="true">

		<div class="flex items-center px-3 border-b h-header-height border-secondary-700 dark:border-base-400 bg-secondary-500 dark:bg-base-600 theme-bnr:bg-base-800 theme-bnr:border-base-50 theme-fd:border-paper-300 theme-fd:bg-paper-200 theme-fd:dark:bg-base-600">
			{% include 'styleguide/components/buttons/button-element.twig' with {
				text: _x('Close', 'Menu', 'fdmg-labels'),
				aria_expanded_support: false,
				class: 'btn-menu-close js-close-menu',
				aria_label: _x('Close menu', 'Menu', 'fdmg-labels'),
				icon: 'close',
				icon_left: true,
			} %}
		</div>

		<div data-component="menu-dropdown" class="relative flex flex-col h-[calc(100%-theme(space.header-height))] outline-base-50 -outline-offset-2 bg-secondary-500 text-base-50 dark:bg-base-600 theme-bnr:bg-base-800 theme-bnr:border-base-50 theme-fd:bg-paper-200 theme-fd:dark:bg-base-600 ">
			<div class="max-h-[calc(100vh-theme(space.header-height)+10px)] overflow-y-auto overflow-x-hidden {{ scrollarea }}">
				<div class="my-3">
					<div class="container">
						{% include 'partials/components/search-header.twig' %}
					</div>
				</div>
				<div class="pb-[2px]">
					<nav aria-label="{{ wp_get_nav_menu_name(constant('PRIMARY_NAV', navigation)) }}" data-module="primary-nav">
						{{ navigation.get_menu(constant('PRIMARY_NAV', navigation), 'primary-nav', 2)|raw }}
					</nav>

					<div class="theme-energeia:hidden theme-pensioen-pro:hidden mt-auto py-[10px] px-3 border-t border-secondary-700 dark:border-base-800 theme-bnr:border-base-50 theme-fd:border-paper-300 theme-fd:text-base-600 theme-fd:dark:text-base-50">
						{% include 'partials/components/header/header-display-options.twig' %}
					</div>
				</div>
			</div>

			{% set newsletter = options.newsletter %}
			{% if newsletter.button.title and newsletter.button.url %}
				<div class="mt-auto border-t border-secondary-300 height-[calc(theme(space.header-height+10px))] dark:border-base-400 theme-bnr:border-base-50 theme-fd:border-paper-300">
					<ul class="flex justify-between h-full flex-nowrap">
						<li class="flex items-center justify-center w-full border-r border-secondary-300 dark:border-base-400 last:border-r-0 ">
							{% include 'styleguide/components/buttons/button-link.twig' with {
								text: newsletter.button.title,
								url: newsletter.button.url,
								class: 'w-full justify-center h-full !text-base-50 !text-lg theme-fd:!text-base-600 theme-fd:dark:!text-base-50',
								is_external: newsletter.button.target ? true,
								aria_label: _x('Sign up to our weekly newsletter', 'Newsletter', 'fdmg-labels'),
								icon: 'email',
								icon_left: true,
							} %}
						</li>
					</ul>
				</div>
			{% endif %}
		</div>

	</div>
	<div data-component="backdrop" aria-hidden="true" class="js-header-menu-backdrop fixed inset-0 bg-[rgb(0,0,0,0.5)] z-[2] transition-all dark:bg-[rgb(0,0,0,0.8)] aria-hidden:invisible aria-hidden:opacity-0"></div>
</div>

<div class="hidden sm:block">
	<nav aria-label="{{ wp_get_nav_menu_name(constant('PRIMARY_NAV', navigation)) }}" data-module="primary-nav">
		{{ navigation.get_menu(constant('PRIMARY_NAV', navigation), 'primary-nav', 2)|raw }}
	</nav>
</div>
