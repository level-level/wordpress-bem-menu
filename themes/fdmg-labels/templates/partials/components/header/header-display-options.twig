{% set radio_id = uniqid('radio') %}

<div data-module="display-options">
	<p class="text-base font-bold">{{ _x('Display preferences', 'DarkMode', 'fdmg-labels') }}</p>
	<div class="mt-3">
		<ul class="flex flex-col" data-module="theme-selection">
			<li>
				<input type="radio" name="theme-choice-{{ radio_id }}" value="light" id="theme-light-{{ radio_id }}" />
				<label for="theme-light-{{ radio_id }}">{{ _x('Light theme', 'DarkMode', 'fdmg-labels') }}</label>
			</li>
			<li>
				<input type="radio" name="theme-choice-{{ radio_id }}" value="dark" id="dark-mode-{{ radio_id }}" />
				<label for="dark-mode-{{ radio_id }}">{{ _x('Dark theme', 'DarkMode', 'fdmg-labels') }}</label>
			</li>
		</ul>
	</div>
</div>
