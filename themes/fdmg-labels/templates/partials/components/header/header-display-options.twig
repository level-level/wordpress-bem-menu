{% set radio_id = uniqid('radio') %}

<div class="dark-mode" data-module="display-options">
	<div class="dark-mode__title">
		{{ __('Display preferences', 'fdmg-labels') }}
	</div>
	<div class="dark-mode__dropdown">
		<div class="dark-mode__inner">
			<ul class="flex flex-col gap-1" data-module="theme-selection">
				<li>
					<input
						type="radio"
						name="theme-choice-{{ radio_id }}"
						value="system"
						id="theme-system-{{ radio_id }}"
						checked
					/>
					<label for="theme-system-{{ radio_id }}">{{ __('System (device settings)', 'fdmg-labels') }}</label>
				</li>
				<li>
					<input type="radio" name="theme-choice-{{ radio_id }}" value="light" id="theme-light-{{ radio_id }}" />
					<label for="theme-light-{{ radio_id }}">{{ __('Light theme', 'fdmg-labels') }}</label>
				</li>
				<li>
					<input type="radio" name="theme-choice-{{ radio_id }}" value="dark" id="dark-mode-{{ radio_id }}" />
					<label for="dark-mode-{{ radio_id }}">{{ __('Dark theme', 'fdmg-labels') }}</label>
				</li>
			</ul>
		</div>
	</div>
</div>
