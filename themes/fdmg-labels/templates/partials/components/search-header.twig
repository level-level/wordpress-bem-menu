{% set random_id = uniqid('searchbar-') %}
<form class="search-component search-component--inline" method="get" action="{{ get_home_url() }}" role="search">
	<div class="flex items-center flex-nowrap">
		<div class="grow">
			<label for="{{ random_id }}" class="screen-reader-text">{{ _x('Search', 'Screen reader text', 'fdmg-labels') }}</label>
			<input
				type="search"
				name="s"
				value="{{ the_search_query() }}"
				id="{{ random_id }}"
				placeholder="{{ _x('Search by keyword', 'Search', 'fdmg-labels') }}"
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
			>
		</div>
		<div class="search-component__button">
			{% include 'styleguide/components/buttons/button-element.twig' with {
				text: '',
				class: 'btn-search',
				aria_label: _x('Search', 'Search', 'fdmg-labels'),
				icon: 'search',
				icon_left: true,
				type: 'submit'
			} %}
		</div>
	</div>
</form>
