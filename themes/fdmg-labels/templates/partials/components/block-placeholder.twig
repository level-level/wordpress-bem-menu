{% if is_admin() %}
	<div class="relative p-6 border-2 border-base-900">
		<p class="m-0">{{ block_text ? block_text|raw : _x('%s. This block is invalid. <strong>Click here to edit this block.</strong>', 'Block', 'fdmg-labels')|format(block.title)|raw }}</p>

		{% if required_fields %}
			<div class="mt-4">
				<p class="font-body-bold">{{ _x('Required fields:', 'Block', 'fdmg-labels') }}</p>
				<ul class="pl-5 list-disc">
					{% for fields in required_fields %}
						<li>{{ fields }}</li>
					{% endfor %}
				</ul>
			</div>
		{% endif %}

		{% if errors %}
			<div class="mt-4">
				<p class="m-0 font-body-bold">{{ _x('Found errors:', 'Block', 'fdmg-labels') }}</p>
				<ul class="pl-5 list-disc">
					{% for error in errors.get_error_messages() %}
						<li>{{ error }}</li>
					{% endfor %}
				</ul>
			</div>
		{% endif %}
	</div>
{% endif %}
