{# Settings pagination for archives and search #}
{# For available args see: https://developer.wordpress.org/reference/functions/paginate_links/ #}

{% set arrow_left = svg_icons.get('arrow-left')|raw %}
{% set arrow_right = svg_icons.get('arrow-right')|raw %}

{% set args = {
		'type': 'list',
		'mid_size': 1,
		'before_page_number': '<span class="screen-reader-text">' ~ __('Page', 'fdmg-labels') ~ '</span>',
		'prev_text': '<span class="icon-inline" aria-hidden="true">' ~ arrow_left ~ '</span><span class="screen-reader-text">' ~ __('Previous page', 'fdmg-labels') ~ '</span>',
		'next_text': '<span class="icon-inline" aria-hidden="true">' ~ arrow_right ~ '</span><span class="screen-reader-text">' ~ __('Next page', 'fdmg-labels') ~ '</span>'
	}
%}

{% if test_args %}
	{% set args = args|merge(test_args) %}
{% endif %}

{% set pagination = paginate_links(args) %}
{% if pagination %}
	<div class="section">
		<nav class="pagination" aria-label="{{ __('Pagination', 'fdmg-labels') }}">
			<h2 class="screen-reader-text">{{ _x('Pagination', 'Screen reader text', 'fdmg-labels') }}</h2>
			{{ pagination|raw }}
		</nav>
	</div>
{% endif %}
