{% if slot %}
	{% if is_admin() %}
		<div class="advertisement">
			<div class="advertisement__selected">
				{{ _x('Selected slot: <strong>%s</strong>', 'Advertisement', 'fdmg-labels')|format(slot)|raw }}
			</div>
		</div>
	{% endif %}

	{% if not is_admin() %}
		{% set class = 'ii-message' %}
		{% if active_theme is same as('energeia') %}
			{% set class = 'en-message' %}
		{% elseif active_theme is same as('pensioen-pro') %}
			{% set class = 'pp-message' %}
		{% endif %}
		<div class="{{ class }}" data-slot="{{ slot }}"></div>
	{% endif %}
{% endif %}
