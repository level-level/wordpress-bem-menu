{% if is_admin() %}
	<div class="gb-placeholder">
		{{ text ? text|raw : _x('%s. This block is empty. <strong>Click here to edit this block.</strong>', 'Block', 'fdmg-labels')|format(block.title)|raw }}

		{% if required_fields %}
			<div class="gb-placeholder__required">
				<p><strong>{{ _x('Required fields:', 'Block', 'fdmg-labels') }}</strong></p>
				<ul>
					{% for field in required_fields %}
						<li>{{ field }}</li>
					{% endfor %}
				</ul>
			</div>
		{% endif %}
	</div>
{% endif %}
