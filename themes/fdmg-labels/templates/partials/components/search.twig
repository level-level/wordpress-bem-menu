{% set random_id = uniqid('searchbar-') %}
<p class="mb-2 font-bold font-heading md:text-xl md:mb-3">{{ _x('Enter a search term', 'Search', 'fdmg-labels') }}</p>

<form data-component="search" class="relative" method="get" action="{{ get_home_url() }}" role="search">
	<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
		<div class="basis-full sm:basis-auto sm:grow">
			<label for="{{ random_id }}" class="sr-only">{{ _x('Search', 'Screen reader text', 'fdmg-labels') }}</label>
			<input
				type="search"
				name="s"
				value="{{ the_search_query() }}"
				id="{{ random_id }}"
				placeholder="{{ _x('Search by keyword', 'Search', 'fdmg-labels') }}"
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
			>
		</div>
		<div class="basis-full sm:basis-auto">
			{% include 'styleguide/components/buttons/button-element.twig' with {
				text: _x('Search', 'Search', 'fdmg-labels'),
				class: 'btn-primary btn-full',
				icon: 'search',
				icon_left: true,
				type: 'submit'
			} %}
		</div>
	</div>
	<input type="hidden" name="period" value="3-years">
	<input type="hidden" name="post_date_min" value="{{ now|date_modify('-3 year')|date('Y-m-d') }}">
	<input type="hidden" name="orderby" value="relevance">
</form>
