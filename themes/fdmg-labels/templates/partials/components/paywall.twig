{% set paywall_content = paywall.get_paywall_options() %}
{% set title = paywall_content.title %}
{% set content = paywall_content.content %}
{% set login_button = paywall_content.login_button %}
{% set subscription_button = paywall_content.subscription_button %}

{% if title and content and login_button and subscription_button %}
	<div data-ll-paywall-module="paywall" data-ll-paywall-post-id="{{ post_id|escape('html_attr') }}" data-name="{{ block.name|escape('html_attr') }}" class="{{ align }} relative before:absolute before:-top-[175px] before:left-0 before:right-0 before:content-[''] before:h-[175px] before:bg-gradient-to-t before:from-secondary-100 before:to-transparent before:dark:from-base-700">
		<div class="relative p-4 sm:p-8 bg-secondary-700 dark:bg-base-400 text-base-50 min-h-[120px] sm:min-h-[150px] sm:text-md font-body-bold">
			<div data-ll-paywall-name="initial-content">
				<div class="flex flex-col gap-2">
					<h2 class="text-lg font-heading text-base-50 xl:text-xl">{{ title }}</h2>

					<div class="ulli:!pl-8 ulli:relative ulli:before:absolute ulli:before:left-0 ulli:before:!content-[''] ulli:before:bg-[url('../images/icons/check.svg')] ulli:before:w-[19px] ulli:before:h-[16px] ulli:before:!top-[5px] ul:!gap-3 ol:!gap-3">
						{{ content|raw }}
					</div>

					{% if login_button or subscription_button %}
						<div class="mt-3">
							<ul class="flex flex-wrap gap-2">
								{% if login_button %}
									<li>
										{% include 'styleguide/components/buttons/button-link.twig' with {
											text: _x('Login', 'Paywall', 'fdmg-labels'),
											url: login_button.url,
											class: 'btn-primary',
											icon: 'external-link',
										} %}
									</li>
								{% endif %}

								{% if subscription_button %}
									<li>
										{% include 'styleguide/components/buttons/button-link.twig' with {
											text: _x('Choose your subscription', 'Paywall', 'fdmg-labels'),
											url: subscription_button.url,
											class: 'btn-primary',
											icon: 'external-link',
										} %}
									</li>
								{% endif %}
							</ul>
						</div>
					{% endif %}
				</div>
			</div>

			{% if not is_admin() %}
				<div data-ll-paywall-name="loader">
					<div class="absolute inset-0 flex items-center justify-center bg-secondary-700 dark:bg-base-400 text-base-50 z-[1]">

						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="w-[70px]">
							<path fill="#fff" d="M73,50c0-12.7-10.3-23-23-23S27,37.3,27,50 M30.9,50c0-10.5,8.5-19.1,19.1-19.1S69.1,39.5,69.1,50">
								<animateTransform
									attributeName="transform"
									type="rotate"
									dur="1s"
									from="0 50 50"
									to="360 50 50"
									repeatCount="indefinite" />
							</path>
						</svg>
					</div>
				</div>
			{% endif %}

		</div>
	</div>
{% endif %}
