{% extends 'archive.twig' %}

{% block header_advertisement_area %}
	{% if is_active_sidebar('widget-area-category-header-ad') %}
		<div class="top-adver">
			{{ sidebar.get_widgetarea('widget-area-category-header-ad')|raw }}
		</div>
	{% endif %}
{% endblock %}

{% block sidebar %}
	{% if is_active_sidebar('widget-area-category') %}
		{{ sidebar.get_widgetarea('widget-area-category')|raw }}
	{% endif %}
{% endblock %}
