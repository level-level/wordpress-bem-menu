{% extends 'layouts/sidebar-layout-with-header.twig' %}

{% block header %}
	<div class="section" {{ datalayer.get_config(object, 'PAGEVIEW') }}>
		<div class="container">
			<div class="w-full md:w-[calc(100%-theme(space.sidebar-width)-theme(space.5))]">
				<h1 class="pb-3 text-lg font-bold border-b-4 font-libre sm:text-3xl text-primary theme-energeia:text-base-500 theme-pensioen-pro:text-base-500 border-secondary-400 dark:text-primary-300 dark:border-primary-300">

					{% if found_posts is same as(1) %}
						{{ _x('%s result found for &lsquo;%s&rsquo;', 'Search', 'fdmg-labels')|format(found_posts, query)|raw }}
					{% else %}
						{# For performance reasons, Elasticsearch will never return more results than 10000.
						Even if there are actually more results.
						To show the user there are actually more results, add a plus character. #}
						{{ _x('%s results found for &lsquo;%s&rsquo;', 'Search', 'fdmg-labels')|format(
							found_posts < 10000 or not is_elasticsearch_result ? found_posts : '10000+',
							query
						)|raw }}
					{% endif %}
				</h1>
			</div>
		</div>
	</div>
{% endblock %}

{% block content %}
	<div class="section">
		{% include 'partials/components/search.twig' %}
		<div class="mt-3 md:hidden">
			{% include 'styleguide/components/buttons/button-element.twig' with {
				text: __('Filter', 'Search', 'fdmg-labels'),
				class: 'btn-quaternary btn-full',
				icon: 'filter',
				icon_expanded: 'close',
				icon_left: true,
				aria_expanded_support: true,
				aria_label: _x('Open filter', 'Search', 'fdmg-labels'),
				data_module: 'filter-modal',
			} %}
		</div>
	</div>

	{% if objects %}
		<div class="relative section">

			{% include 'partials/components/skiplink.twig' with {
				text: _x('Straight to filters', 'Screen reader text', 'fdmg-labels'),
				target: '#filters',
			} %}

			<h2 class="sr-only">{{ _x('Search results', 'Screen reader text', 'fdmg-labels') }}</h2>
			<ul class="flex flex-col gap-3 sm:gap-6">

				{% for object in objects %}

					{% set image_id = object.get_thumbnail_id() %}
					{% set authors = object.get_authors() %}

					{% if not feature_manager.is_enabled(constant('FEATURE_DISABLE_CATEGORY_TAXONOMY', feature_manager)) %}
						{% set categories = object.get_terms('category') %}
					{% endif %}

					{% if feature_manager.is_enabled(constant('FEATURE_ENABLE_GENRE_TAXONOMY', feature_manager)) %}
						{% set genres = object.get_terms('fdmg_genre') %}
					{% endif %}

					{% if feature_manager.is_enabled(constant('FEATURE_ENABLE_SECTION_TAXONOMY', feature_manager)) %}
						{% set sections = object.get_terms('fdmg_section') %}
					{% endif %}

					<li>
						{% include 'styleguide/components/teasers/teaser-post-wide.twig' with {
							image: image_id ? wp_get_attachment_image(image_id, 'thumbnail', false, {alt: ''}),
							title: object.get_alternative_title()|default(object.get_title()),
							url: object.get_permalink(),
							excerpt: object.get_excerpt(),
							date: object.get_publish_date(),
							categories: categories ? categories|map(category => {
								name: category.get_name(),
							}),
							genres: genres ? genres|map(genre => {
								name: genre.get_name(),
							}),
							sections: sections ? sections|map(section => {
								name: section.get_name(),
							}),
							authors: authors ? authors|map(author => {
								name: author.get_title(),
								location: author.get_location(),
								url: author.get_permalink(),
							}),
							useH3: true,
							show_paywall_label: not object.has_paywall_block() and feature_manager.is_enabled(constant('FEATURE_ENABLE_PAYWALL_LABEL', feature_manager)),
							article_id: object.get_id(),
							component_subtype: 'search results',
						} %}
					</li>
				{% endfor %}
			</ul>
		</div>

		{% include 'partials/components/pagination.twig' %}
	{% else %}
		<div class="section">
			<p>{{ _x('No search results found', 'Search', 'fdmg-labels') }}</p>
		</div>
	{% endif %}
{% endblock %}

{% block sidebar %}

	{% include 'partials/components/search-filter.twig' %}

	{% if is_active_sidebar('widget-area-search-results') %}
		{{ sidebar.get_widgetarea('widget-area-search-results')|raw }}
	{% endif %}
{% endblock %}
