{% extends 'layouts/sidebar-layout-with-header.twig' %}

{% block header %}
	<div class="section">
		<div class="container">
			<div class="w-full md:w-[calc(100%-theme(space.sidebar-width)-theme(space.5))]">
				<h1 class="pb-3 text-lg font-bold border-b-4 font-libre sm:text-3xl text-base-500 border-secondary-400 dark:text-primary-300 dark:border-primary-300">{{ single_cat_title() }}</h1>

				{% set description = term.get_formatted_description() %}
				{% if description %}
					<div class="mt-4">
						{{ description|raw }}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}

{% block content %}
	{% if objects %}
		<div class="section">
			<ul class="flex flex-col gap-3 sm:gap-6">
				{% for object in objects %}
					{% set image_id = object.get_thumbnail_id() %}
					{% set categories = object.get_terms('fdmg_serie') %}

					<li>
						{% include 'styleguide/components/teasers/teaser-post-wide.twig' with {
							image: image_id ? wp_get_attachment_image(image_id, 'thumbnail'),
							title: object.get_title(),
							url: object.get_permalink(),
							excerpt: object.get_excerpt(),
							date: object.get_publish_date(),
							categories: categories ? categories|map(category => {
								name: category.get_name(),
							}),
						} %}
					</li>
				{% endfor %}
			</ul>
		</div>

		{% include 'partials/components/pagination.twig' %}
	{% endif %}
{% endblock %}

{% block sidebar %}

{% endblock %}
