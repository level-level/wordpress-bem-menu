{% extends 'layouts/sidebar-layout-with-header.twig' %}

{% block header %}
	<div class="section">
		<div class="container">
			<div class="w-full md:w-[calc(100%-theme(space.sidebar-width)-theme(space.5))]">
				<h1 class="pb-3 text-lg font-bold border-b-4 font-heading sm:text-3xl text-primary theme-energeia:text-base-800 border-secondary-400 dark:text-primary-300 dark:border-primary-300">{{ post_type.get_archive_title() }}</h1>

				{% set intro = archive.intro %}
				{% if intro %}
					<div class="mt-4">
						{{ intro|raw }}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}

{% block content %}
	{% if objects %}
		<div class="section">
			<ul class="flex flex-col gap-3 sm:gap-6">
				{% set date_format = get_option('date_format') %}

				{% for object in objects %}

					{% set image_id = object.get_thumbnail_id() %}
					{% set categories = object.get_terms('fdmg_serie') %}

					<li>
						{% include 'styleguide/components/teasers/teaser-post-wide.twig' with {
							image: image_id ? wp_get_attachment_image(image_id, 'thumbnail'),
							title: object.get_title(),
							url: object.get_permalink(),
							excerpt: object.get_excerpt(),
							date: object.get_date_i18n(date_format),
							date_full: object.get_date_i18n('F j Y'),
							datetime: object.get_date_i18n('Y-m-d'),
							categories: categories ? categories|map(category => {
								name: category.get_name(),
							}),
						} %}
					</li>
				{% endfor %}
			</ul>
		</div>

		{% include 'partials/components/pagination.twig' %}
	{% endif %}
{% endblock %}

{% block sidebar %}

{% endblock %}
