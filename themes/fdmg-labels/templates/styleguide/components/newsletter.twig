{% if title or image or content or button %}
	<div data-component="newsletter" class="relative bg-secondary-200 dark:bg-base-600">
		<div class="p-3 sm-4">
			<div class="flex flex-col gap-6">

				{% if title %}
					<h3 class="text-base font-bold sm:text-md">
						{{ title }}
					</h3>
				{% endif %}

				{% if image %}
					<div class="border-b border-secondary-400 -mx-3 dark:border-base-800 dark:bg-base-600 sm:-mx-3 image:mx-auto image:max-w-[92px]">
						{{ image|raw }}
					</div>
				{% endif %}

				{% if content %}
					<div class="font-normal text-base sm:text-[17px]">
						{{ content|raw }}
					</div>
				{% endif %}

				{% if button.title and button.url %}
					<div>
						{% include 'styleguide/components/buttons/button-link.twig' with {
							text: button.title,
							url: button.url,
							class: 'btn--primary btn--full',
							is_external: button.target ? true,
							aria_label: _x('Sign up to our weekly newsletter', 'Newsletter', 'fdmg-labels'),
						} %}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endif %}
