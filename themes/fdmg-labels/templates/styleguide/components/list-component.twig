{#
	Options
	style:
		- no style: default
		- dark: a more dark version
		- light: transparent version
	heading: a title above the list
	button_text and button_link to show a button underneath the list

#}
{% if objects %}
	<ul class="text-base sm:text-md
		{{ style is same as('dark') ? 'bg-secondary-100 dark:bg-base-600' }}
		{{ style is same as('light') ? 'border border-secondary-400 dark:border-base-600' }}
	">

		{% if heading %}
			<li class="p-3 sm:p-4">
				<h3 class="text-base font-body-bold text-primary dark:text-primary-300 theme-energeia:text-base-800">
					{{ heading }}
				</h3>
			</li>
		{% endif %}

		{% for object in objects %}
			<li class="p-3 border-t sm:p-4 border-[rgb(0,0,0,0.1)] dark:border-base-400
			{{ style is same as('dark') ? 'border-secondary-400 dark:border-base-800' }}
			{{ style is same as('light') ? 'border-secondary-400 dark:border-base-600' }}">
				{% include 'styleguide/components/list-item.twig' with {
					title: object.title,
					url: object.url,
					terms: object.terms,
					term_label: term_label,
					date: object.date,
					datetime: object.datetime,
					date_full: object.date_full,
				} %}
			</li>
		{% endfor %}

		{% if button_text and button_link %}
			<li class="p-3 border-t sm:py-2 sm:px-4 border-[rgb(0,0,0,0.1)] dark:border-base-400
			{{ style is same as('dark') ? 'border-secondary-400 dark:border-base-800' }}
			{{ style is same as('light') ? 'border-secondary-400 dark:border-base-600' }}">
				{% include 'styleguide/components/buttons/button-link.twig' with {
					text: button_text,
					url: button_link,
					class: 'btn-tertiary',
					is_external: false,
					icon: 'arrow-right',
					icon_left: true,
					highlight_icon: true,
				} %}
			</li>
		{% endif %}
	</ul>
{% endif %}
