{#
	Options
	style:
		- no style: default
		- dark: a more dark version
		- light: transparent version
	heading: a title above the list
	button_text and button_link to show a button underneath the list

#}
{% if objects %}
	<ul data-component="list-component" class="text-base sm:text-md
		{{ style is same as('dark') ? 'bg-secondary-100 dark:bg-base-600 theme-fd:bg-paper-50' }}
		{{ style is same as('light') ? 'border border-secondary-400 dark:border-base-600 theme-fd:border-paper-300' }}
	">

		{% if heading %}
			<li class="p-3 sm:p-4">
				<h3 class="text-base font-bold font-figtree text-primary dark:text-primary-300 theme-energeia:text-base-800 theme-fd:font-proxima theme-fd:text-base-600">
					{{ heading }}
				</h3>
			</li>
		{% endif %}

		{% for object in objects %}
			<li class="p-3 border-t sm:px-4 sm:py-[10px] border-[rgb(0,0,0,0.1)] dark:border-base-400 theme-fd:border-paper-300
			{{ style is same as('dark') ? 'border-secondary-400 dark:border-base-800' }}
			{{ style is same as('light') ? 'border-secondary-400 dark:border-base-600  theme-fd:border-paper-300' }}">
				{% include 'styleguide/components/list-item.twig' with {
					title: object.title,
					url: object.url,
					terms: object.terms,
					term_label: object.term_label,
					date: object.date,
					datetime: object.datetime,
					comment_content: object.comment_content,
					comment_author: object.comment_author,
					comment_count: object.comment_count,
					component_subtype: 'list_component',
					object: object.post,
				} %}
			</li>
		{% endfor %}

		{% if button_text and button_link %}
			<li class="p-3 border-t sm:py-2 sm:px-4 border-[rgb(0,0,0,0.1)] dark:border-base-400 theme-fd:border-paper-300
			{{ style is same as('dark') ? 'border-secondary-400 dark:border-base-800' }}
			{{ style is same as('light') ? 'border-secondary-400 dark:border-base-600' }}">
				{% include 'styleguide/components/buttons/button-link.twig' with {
					text: button_text,
					url: button_link,
					class: 'btn-tertiary',
					is_external: false,
					icon: 'arrow-right',
					icon_left: true,
					highlight_icon: true,
				} %}
			</li>
		{% endif %}
	</ul>
{% endif %}
