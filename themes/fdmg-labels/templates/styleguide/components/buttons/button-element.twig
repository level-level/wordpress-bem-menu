{#
	Button element

	Options:
	text: text in the button
	class: button class
	icon: svg icon name from images/icons/
	icon_expanded: svg icon name, only visible if button is expanded
	icon_left: bool
	aria_expanded_support: bool
	aria_label: aria label on the link
	aria_collapsed_text: string e.g. 'Open the search'
	aria_expanded_text: string e.g. 'Close the search'
	type: string e.g. 'submit'
	data_module: string e.g. when wanting to add a js module on the button
	data_config: object e.g. adds the data-config property
	id: string as an id
#}

{% if aria_expanded_support %}
	{% set aria_expanded = 'aria-expanded="false"' %}
{% endif %}

{% if aria_label %}
	{% set aria_label = 'aria-label="%s"'|format(aria_label) %}
{% endif %}

{% if type %}
	{% set type = 'type="%s"'|format(type) %}
{% endif %}

{% if aria_collapsed_text %}
	{% set aria_collapsed_text = 'data-collapsed="%s"'|format(aria_collapsed_text) %}
{% endif %}

{% if aria_expanded_text %}
	{% set aria_expanded_text = 'data-expanded="%s"'|format(aria_expanded_text) %}
{% endif %}

{% if data_module %}
	{% set data_module = 'data-module="%s"'|format(data_module) %}
{% endif %}

{% if data_config %}
	{% set data_config = "data-config='%s'"|format(data_config) %}
{% endif %}

{% if id %}
	{% set id = 'id="%s"'|format(id) %}
{% endif %}

{% if focusable is same as(false) %}
	{% set tabindex = 'tabindex="-1"' %}
{% endif %}

{% if icon_expanded or aria_expanded_support %}
	{% set icon_expanded = icon_expanded ? icon_expanded : icon %}
{% endif %}

{% set highlighted_icon_style = 'bg-primary text-base-50 w-[34px] h-[34px] rounded-full flex items-center justify-center transition-all dark:bg-primary-300 theme-energeia:dark:text-base-700 group-hover/button:translate-x-2 group-hover/button:bg-transparent group-focus/button:translate-x-2 group-focus/button:bg-transparent' %}

<button class="btn {{ class|raw }} group/button" {{ id|raw }} {{ data_module|raw }} {{ data_config|raw }} {{ aria_expanded|raw }} {{ aria_label|raw }} {{ aria_collapsed_text|raw }} {{ aria_expanded_text|raw }} {{ type|raw }} {{ tabindex|raw }}>
	{% if icon and icon_left %}
		<span class="btn__icon {{ highlight_icon ? highlighted_icon_style }}">
			<span class="icon-inline icon-{{ icon }}" aria-hidden="true">{{ svg_icons.get(icon)|raw }}</span>

			{% if icon_expanded %}
				<span class="icon-inline icon-inline--expanded icon-{{ icon }}" aria-hidden="true">{{ svg_icons.get(icon_expanded)|raw }}</span>
			{% endif %}
		</span>
	{% endif %}

	{% if text %}
		<span class="btn__text">
			{{ text|raw }}
		</span>
	{% endif %}

	{% if icon and not icon_left %}
		<span class="btn__icon {{ highlight_icon ? highlighted_icon_style }}">
			<span class="icon-inline icon-{{ icon }}" aria-hidden="true">{{ svg_icons.get(icon)|raw }}</span>

			{% if icon_expanded %}
				<span class="icon-inline icon-inline--expanded icon-{{ icon }}" aria-hidden="true">{{ svg_icons.get(icon_expanded)|raw }}</span>
			{% endif %}
		</span>
	{% endif %}
</button>
