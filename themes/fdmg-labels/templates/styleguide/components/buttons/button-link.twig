{#
	Button link

	Options:
	text: text in the button
	url: link of the button
	is_external: bool - if the link links to an external source
	class: button class
	aria_label: aria label on the link
	icon: svg icon name from images/icons/
	icon_left: bool
	highlight_icon: bool
#}

{% if is_external %}
	{% set external = 'target="_blank" rel="noopener"' %}
{% endif %}

{% if aria_label %}
	{% set aria_label = 'aria-label="%s"'|format(aria_label) %}
{% endif %}

{% if data_module %}
	{% set data_config = "data-module='%s'"|format(data_module) %}
{% endif %}

{% if data_type %}
	{% set data_type = "data-type='%s'"|format(data_type) %}
{% endif %}

{% if data_config %}
	{% set data_config = "data-config='%s'"|format(data_config) %}
{% endif %}

{% if focusable is same as(false) %}
	{% set tabindex = 'tabindex="-1"' %}
{% endif %}

{% set highlighted_icon_style = 'bg-primary text-base-50 w-[28px] h-[28px] rounded-full flex items-center justify-center transition-all theme-energeia:text-base-800 dark:bg-primary-300 theme-energeia:dark:text-base-700 theme-pensioen-pro:dark:text-base-700 group-hover/button:translate-x-2 group-hover/button:bg-transparent group-focus/button:translate-x-2 group-focus/button:bg-transparent' %}

{% if url %}
	<a href="{{ url|raw }}" class="group/button btn {{ class|raw }}" {{ external|raw }} {{ aria_label|raw }} {{ data_module|raw }} {{ data_type|raw }} {{ data_config|raw }} {{ tabindex|raw }}>
		{% if icon and icon_left %}
			<span class="btn__icon {{ highlight_icon ? highlighted_icon_style }}">
				<span class="icon-inline icon-{{ icon }}" aria-hidden="true">{{ svg_icons.get(icon)|raw }}</span>
			</span>
		{% endif %}

		{% if text %}
			<span class="btn__text">
				{{ text|raw }}

				{% if is_external %}
					<span class="sr-only">{{ _x('Opens in a new window', 'Screen reader text', 'fdmg-labels') }}</span>
				{% endif %}
			</span>
		{% endif %}

		{% if icon and not icon_left %}
			<span class="btn__icon {{ highlight_icon ? highlighted_icon_style }}">
				<span class="icon-inline icon-{{ icon }}" aria-hidden="true">{{ svg_icons.get(icon)|raw }}</span>
			</span>
		{% endif %}
	</a>
{% endif %}
