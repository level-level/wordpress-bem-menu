<div class="article-header">

	{% if label %}
		<div class="article-header__label">
			<ul class="flex gap-1">
				<li>
					<div class="badge badge--rich">
						{{ label|raw }}
					</div>
				</li>
			</ul>
		</div>
	{% endif %}

	{% if terms %}
		<div class="article-header__terms">
			{% include 'styleguide/components/post-terms.twig' with {
				terms: terms,
			} %}
		</div>
	{% endif %}

	<div class="article-header__title">
		<h1>{{ title|raw }}</h1>
	</div>

	{% if authors or date and datetime and date_full %}
		<div class="article-header__meta">
			<div class="flex gap-6 items-center">

				{% if authors %}
					<div>
						<span class="screen-reader-text">
							{{ __('Written by:', 'fdmg-labels') }}
						</span>
						<ul class="flex gap-3">
							{% for object in authors %}
								<li>
									{% include 'styleguide/components/buttons/button-link.twig' with {
										text: object.name,
										url: object.url,
										class: 'btn--secondary btn--no-padding',
									} %}
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

				{% if date and datetime and date_full %}
					<div>
						<span class="screen-reader-text">{{ __('Published on: %s', 'fdmg-labels')|format(date_full)|raw }}</span>
						<time datetime="{{ datetime|raw }}" aria-hidden="true">{{ date|raw }}</time>
					</div>
				{% endif %}

			</div>
		</div>
	{% endif %}
</div>
