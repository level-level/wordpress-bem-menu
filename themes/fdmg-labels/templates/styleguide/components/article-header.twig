{% set has_paywall_block = object.has_paywall_block() %}
<div data-component="article-header" class="relative flex flex-col mb-6 sm:mb-8">

	<div class="hidden print:font-bold print:block print:mb-8">
		{{ __('Source: %s, %s', 'fdmg-labels')|format(get_bloginfo('name'), date.date_full)|raw }}
	</div>

	<div class="order-2">
		<h1 class="text-lg font-bold break-words font-libre text-secondary-700 theme-pensioen-pro:text-base-500 theme-energeia:text-base-500 dark:text-primary-300 sm:text-3xl" {{ has_paywall_block ? 'aria-describedby="a11y-paywall-description"' }}>
			{{ title|raw }}

			{% if has_paywall_block %}
				<span class="screen-reader-text js-paywall-a11y-description">&mdash; {{ _x('article includes a paywall', 'Screen Reader Text', 'fdmg-labels') }}</span>
			{% endif %}
		</h1>

		{% if has_paywall_block %}
			<p class="screen-reader-text js-paywall-a11y-description" id="a11y-paywall-description">{{ _x('This article has a paid access block, which means that some of the content cannot be read until you are logged in and have a valid subscription.', 'Screen Reader Text', 'fdmg-labels') }}</p>
		{% endif %}
	</div>

	{% if label %}
		<div class="order-1 mb-3 sm:mb-9">
			<ul class="flex gap-1">
				<li>
					{% include 'styleguide/components/badges/badge.twig' with {
						title: label,
						rich: true,
					} %}
				</li>
			</ul>
		</div>
	{% endif %}

	{% if categories or genres or sections %}
		<div class="order-1 mb-3 sm:mb-9 print:hidden">

			<div class="flex gap-2">
				{% if categories %}
					{% include 'styleguide/components/post-terms.twig' with {
						terms: categories,
						label: _x('category', 'Screen reader text', 'fdmg-labels'),
					} %}
				{% endif %}

				{% if genres %}
					{% include 'styleguide/components/post-terms.twig' with {
						terms: genres,
						label: _x('genre', 'Screen reader text', 'fdmg-labels'),
					} %}
				{% endif %}

				{% if sections %}
					{% include 'styleguide/components/post-terms.twig' with {
						terms: sections,
						label: _x('section', 'Screen reader text', 'fdmg-labels'),
					} %}
				{% endif %}
			</div>

		</div>
	{% endif %}

	{% if authors or date.date and date.datetime and date.date_full %}
		<div class="order-3 mt-3">
			<div class="flex items-center gap-6 flex-wrap">

				{% if authors %}
					<div>
						<span class="sr-only">
							{{ _x('Written by:', 'Screen reader text', 'fdmg-labels') }}
						</span>
						<ul class="flex gap-4 flex-wrap">
							{% for object in authors %}
								<li class="flex gap-1 items-center">
									{% include 'styleguide/components/buttons/button-link.twig' with {
										text: object.name,
										url: object.url,
										class: 'btn-secondary !p-0 !text-base !border-0 theme-energeia:text-base-800 theme-energeia:dark:text-primary-300 hocus:!underline',
									} %}
									{% if object.email %}
										{% include 'styleguide/components/buttons/button-link.twig' with {
											text: '',
											icon: 'email',
											url: 'mailto:' ~ object.email,
											class: 'btn-secondary !p-0 !border-0 !text-lg theme-energeia:text-base-800 theme-energeia:dark:text-primary-300',
											aria_label: _x('Send an email to %s', 'Screen reader text', 'fdmg-labels')|format(object.name),
										} %}
									{% endif %}
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

				{% if date.date and date.datetime and date.date_full %}
					<div class="flex">
						<span class="sr-only">{{ _x('Published: %s', 'Screen reader text', 'fdmg-labels')|format(date.date_full)|raw }}</span>
						<time datetime="{{ date.datetime|raw }}" aria-hidden="true" class="text-base font-bold">{{ date.date_full|raw }}</time>
					</div>
				{% endif %}

			</div>
		</div>
	{% endif %}

	{% if notice %}
		<div class="order-last mt-2 text-base font-bold">
			{{ notice|raw }}
		</div>
	{% endif %}

	{% if has_comments_enabled %}
		<div class="order-last mt-4">
			{% include 'styleguide/components/buttons/button-link.twig' with {
				text: _x('Add comment', 'Button text', 'fdmg-labels'),
				url: '#comment-form',
				class: 'btn-secondary !p-0 !border-0 !text-base theme-energeia:text-base-800 theme-energeia:dark:text-primary-300 hocus:!underline',
			} %}
		</div>
	{% endif %}
</div>
