<div data-component="article-header" class="relative flex flex-col mb-6 sm:mb-12">

	<div class="order-2">
		<h1 class="font-bold font-heading text-secondary-600 dark:text-primary-300 text-[26px] leading-9 sm:text-[40px] sm:leading-[3.5rem] lg:text-[48px] lg:leading-[3.875rem]">{{ title|raw }}</h1>
	</div>

	{% if label %}
		<div class="order-3 mb-3 sm:mb-9">
			<ul class="flex gap-1">
				<li>
					{% include 'styleguide/components/badges/badge.twig' with {
						title: label,
						rich: true,
					} %}
				</li>
			</ul>
		</div>
	{% endif %}

	{% if categories or genres or sections %}
		<div class="order-1 mb-3 sm:mb-9">

			<div class="flex gap-2">
				{% if categories %}
					{% include 'styleguide/components/post-terms.twig' with {
						terms: categories,
						label: _x('category', 'Screen reader text', 'fdmg-labels'),
					} %}
				{% endif %}

				{% if genres %}
					{% include 'styleguide/components/post-terms.twig' with {
						terms: genres,
						label: _x('genre', 'Screen reader text', 'fdmg-labels'),
					} %}
				{% endif %}

				{% if sections %}
					{% include 'styleguide/components/post-terms.twig' with {
						terms: sections,
						label: _x('section', 'Screen reader text', 'fdmg-labels'),
					} %}
				{% endif %}
			</div>

		</div>
	{% endif %}

	{% if authors or date and datetime and date_full %}
		<div class="order-3 mt-3">
			<div class="flex items-center gap-6">

				{% if authors %}
					<div>
						<span class="sr-only">
							{{ _x('Written by:', 'Screen reader text', 'fdmg-labels') }}
						</span>
						<ul class="flex gap-3">
							{% for object in authors %}
								<li>
									{% include 'styleguide/components/buttons/button-link.twig' with {
										text: object.name,
										url: object.url,
										class: 'btn-secondary !p-0 !text-[17px] theme-energeia:text-base-800 theme-energeia:dark:text-primary-300',
									} %}
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

				{% if date and datetime and date_full %}
					<div>
						<span class="sr-only">{{ _x('Published on: %s', 'Screen reader text', 'fdmg-labels')|format(date_full)|raw }}</span>
						<time datetime="{{ datetime|raw }}" aria-hidden="true" class="font-body-bold text-[17px]">{{ date|raw }}</time>
					</div>
				{% endif %}

			</div>
		</div>
	{% endif %}
</div>
