<div data-component="article-header" class="relative mb-6 sm:mb-12">

	{% if label %}
		<div class="mb-3 sm:mb-9">
			<ul class="flex gap-1">
				<li>
					<div class="badge badge--rich">
						{{ label|raw }}
					</div>
				</li>
			</ul>
		</div>
	{% endif %}

	{% if terms %}
		<div class="mb-3 sm:mb-9">
			{% include 'styleguide/components/post-terms.twig' with {
				terms: terms,
			} %}
		</div>
	{% endif %}

	<div>
		<h1>{{ title|raw }}</h1>
	</div>

	{% if authors or date and datetime and date_full %}
		<div class="mt-3">
			<div class="flex items-center gap-6">

				{% if authors %}
					<div>
						<span class="screen-reader-text">
							{{ _x('Written by:', 'Screen reader text', 'fdmg-labels') }}
						</span>
						<ul class="flex gap-3">
							{% for object in authors %}
								<li>
									{% include 'styleguide/components/buttons/button-link.twig' with {
										text: object.name,
										url: object.url,
										class: 'btn--secondary btn--no-padding !text-[17px]',
									} %}
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

				{% if date and datetime and date_full %}
					<div>
						<span class="screen-reader-text">{{ _x('Published on: %s', 'Screen reader text', 'fdmg-labels')|format(date_full)|raw }}</span>
						<time datetime="{{ datetime|raw }}" aria-hidden="true" class="font-bold text-[17px]">{{ date|raw }}</time>
					</div>
				{% endif %}

			</div>
		</div>
	{% endif %}
</div>
