{% if partner %}
	<div class="md:flex-shrink md:w-[theme(space.sidebar-width)]">
		<div class="block md:z-10 md:mt-6 md:sticky md:top-[calc(theme(space.header-height)+theme(space.6)+theme(space.admin-bar))]" aria-hidden="true">
			<div class="h-full">
				<div class="mt-6">
					<div class="relative text-base font-body bg-secondary-200 dark:bg-base-600 sm:text-md">
						<div class="p-3 sm:p-4">
							<p>{{ _x('<strong>%s</strong> is responsible for the contents of this page.', 'Partner', 'fdmg-labels')|format(partner)|raw }}</p>
							<p>{{ _x('Any statements or opinions expressed within the content are solely the authors and do not reflect the opinions and beliefs of the website or its affiliates.', 'Partner', 'fdmg-labels') }}</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endif %}
