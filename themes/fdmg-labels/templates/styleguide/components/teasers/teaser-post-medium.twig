<div data-teaser-post data-component="teaser-post-medium" {{ datalayer.get_config(object, 'TEASER', component_subtype) }} class="relative flex flex-col h-full transition-shadow border-b-2 font-figtree bg-base-50 border-secondary-400 theme-energeia:border-primary theme-pensioen-pro:border-primary dark:border-transparent dark:bg-base-600 hocus:shadow-teaser group/teaser theme-fd:font-proxima theme-fd:bg-paper-50 theme-fd:border-paper-300 theme-fd:dark:bg-paper-800 theme-fd:dark:text-paper-50 theme-fd:dark:border-paper-600 theme-bnr:font-jakarta theme-bnr:border theme-bnr:border-base-200">

	{% if image %}
		<div class="relative overflow-hidden aspect-video image:w-full image:h-full image:object-cover">
			{{ image|raw }}

			{% if show_paywall_label %}
				<div class="absolute bottom-2 right-2 z-[2]">
					{% include 'styleguide/components/teasers/post/paywall-label.twig' %}
				</div>
			{% endif %}
		</div>
	{% endif %}

	<div class="p-3 sm:p-4">
		{% include 'styleguide/components/teasers/post/header.twig' with {
			useH3: useH3,
			url: url,
			title: title,
			categories: categories,
			genres: genres,
			sections: sections,
			date: date,
			small: small,
			show_paywall_label: show_paywall_label,
		} only %}

		{% if excerpt %}
			<div class="mt-3 text-base sm:text-[17px] sm:leading-6">
				{{ excerpt|raw }}
			</div>
		{% endif %}
	</div>

	{% include 'styleguide/components/teasers/post/footer.twig' with {
		title: title,
		authors: authors,
		comments: comments,
		url: url,
	} %}
</div>
