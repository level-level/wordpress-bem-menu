{% set authors_string = authors|map(author.name)|join(', ') %}
{% set datalayer_config = {
	title: title,
	author: authors_string,
	id: article_id,
	publication_date: publication_date,
	publication_time: publication_time,
	revisions_count: revisions_count,
	article_index: article_index,
	component_subtype: component_subtype,
	categories: categories,
}|json_encode(constant('JSON_HEX_QUOT')) %}

<div data-component="teaser-post-medium" data-module="datalayer" data-type="article_impression" data-config="{{ datalayer_config }}" class="relative flex flex-col h-full transition-shadow border-b-2 font-figtree bg-base-50 border-secondary-400 theme-energeia:border-primary theme-pensioen-pro:border-primary dark:border-transparent dark:bg-base-600 hocus:shadow-teaser group/teaser">

	{% if image %}
		<div class="relative overflow-hidden aspect-video image:w-full image:h-full image:object-cover">
			{{ image|raw }}

			{% if show_paywall_label %}
				<div class="absolute bottom-2 right-2 z-[2]">
					{% include 'styleguide/components/teasers/post/paywall-label.twig' %}
				</div>
			{% endif %}
		</div>
	{% endif %}

	<div class="p-3 sm:p-4">
		{% include 'styleguide/components/teasers/post/header.twig' with {
			useH3: useH3,
			url: url,
			title: title,
			categories: categories,
			genres: genres,
			sections: sections,
			date: date,
			small: small,
			show_paywall_label: show_paywall_label,
			datalayer_config: datalayer_config,
		} only %}

		{% if excerpt %}
			<div class="mt-3 text-base sm:text-[17px] sm:leading-6">
				{{ excerpt|raw }}
			</div>
		{% endif %}
	</div>

	{% include 'styleguide/components/teasers/post/footer.twig' with {
		title: title,
		authors: authors,
		comments: comments,
		url: url,
	} %}
</div>
