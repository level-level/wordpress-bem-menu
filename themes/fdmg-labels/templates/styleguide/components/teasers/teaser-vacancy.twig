<div data-component="teaser-vacancy" class="relative flex flex-col">
	<div class="p-3 bg-secondary-100 dark:bg-base-600 sm:p-6">
		<div class="flex flex-wrap gap-3 sm:flex-nowrap justify-between">

			<div class="basis-full sm:basis-auto sm:shrink-0 sm:order-2">
				{% if image %}
					<div class="max-w-[160px] lg:max-w-[220px] mb-3 bg-transparent p-3 dark:bg-base-100 sm:mb-0">
						{{ image|raw }}
					</div>
				{% endif %}
			</div>

			<div class="basis-full sm:basis-auto">
				<div class="flex flex-col gap-3">
					<h3 class="font-bold text-md text-base-500 dark:text-base-100">
						{{ title|raw }}
					</h3>

					{% include 'styleguide/components/vacancy-metadata.twig' with {
						company_name: company_name,
						location: location,
					} %}

					{% if excerpt %}
						<div class="text-base">
							{{ excerpt|raw }}
						</div>
					{% endif %}

					<div>
						{% include 'styleguide/components/buttons/button-link.twig' with {
							text: _x('View vacancy', 'Block', 'fdmg-labels'),
							url: url,
							class: 'btn-tertiary',
							aria_label: _x('View vacancy, %s', 'Screen reader text', 'fdmg-labels')|format(title),
							icon: 'arrow-right',
							icon_left: true,
							highlight_icon: true,
						} %}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
