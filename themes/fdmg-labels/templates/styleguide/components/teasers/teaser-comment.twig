		<div class="text-base font-body-bold text-secondary-700 dark:text-primary-300">
			{{ author }}
		</div>
		<div class="text-base font-body text-secondary-700 dark:text-primary-300">
			{{ time|raw }}
		</div>
	</div>
	<div class="text-base mt-[5px] sm:text-md">
		<p>
			{{ content }}
		</p>
	</div>
</div>
