<div class="teaser-team">
	<div class="teaser-team__inner">
		<div class="flex gap-6 flex-col sm:flex-row sm:flex-nowrap">

			<div class="shrink-0">
				<div class="teaser-team__thumbnail">
					{% if image %}
						{{ image|raw }}
					{% endif %}
				</div>
			</div>

			<div class="flex flex-col gap-3">
				<h3 class="teaser-team__title">
					{{ title|raw }}
				</h3>

				{% if excerpt %}
					{{ excerpt|raw }}
				{% endif %}

				<div>
					{% include 'styleguide/components/buttons/button-link.twig' with {
						text: __('View profile', 'fdmg-labels'),
						url: url,
						class: 'btn--tertiary',
						aria_label: __('View profile, %s', 'fdmg-labels')|format(title),
						icon: 'arrow-right',
						icon_left: true,
						highlight_icon: true,
					} %}
				</div>
			</div>
		</div>
	</div>
</div>
