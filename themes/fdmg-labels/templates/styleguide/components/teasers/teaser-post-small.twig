<div data-component="teaser-post-small" class="relative flex flex-col h-full transition-shadow border-b font-figtree bg-base-50 border-secondary-400 theme-energeia:border-primary theme-pensioen-pro:border-primary dark:border-transparent dark:bg-base-600 hocus:shadow-teaser sm:border-b-2 group/teaser">

	{# Mobile only #}
	<div class="sm:hidden">
		<div class="p-3 sm:p-4">
			<div class="flex items-center gap-6">
				<div class="grow">
					{% include 'styleguide/components/teasers/post/header.twig' with {
						useH3: useH3,
						url: url,
						title: title,
						categories: categories,
						genres: genres,
						sections: sections,
						small: true,
						show_paywall_label: show_paywall_label,
					} only %}

					{% if show_paywall_label %}
						<div class="inline-flex mt-2 mb-1">
							{% include 'styleguide/components/teasers/post/paywall-label.twig' %}
						</div>
					{% endif %}
				</div>

				{% if image_square %}
					<div class="shrink-0">
						<div class="max-w-[65px]">
							{{ image_square|raw }}
						</div>
					</div>
				{% endif %}
			</div>
		</div>
	</div>

	{# Tablet only #}
	<div class="hidden sm:block lg:hidden">
		<div class="flex">

			{% if image %}
				<div class="shrink-0">
					<div class="relative overflow-hidden aspect-[13/9] sm:w-[230px] sm:h-full lg:aspect-video lg:w-auto lg:h-auto image:w-full image:h-full image:object-cover">
						{{ image|raw }}
					</div>
				</div>
			{% endif %}

			<div class="grow">
				<div class="p-3 sm:p-4">
					{% include 'styleguide/components/teasers/post/header.twig' with {
						useH3: useH3,
						url: url,
						title: title,
						categories: categories,
						genres: genres,
						sections: sections,
						date: date,
						small: true,
						show_paywall_label: show_paywall_label,
					} only %}

					{% if show_paywall_label %}
						<div class="inline-flex mt-4 mb-1">
							{% include 'styleguide/components/teasers/post/paywall-label.twig' %}
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>

	{# Desktop only #}
	<div class="hidden lg:block lg:h-full">
		<div class="lg:flex lg:flex-col lg:h-full">
			{% if image %}
				<div class="relative overflow-hidden aspect-video image:w-full image:h-full image:object-cover">
					{{ image|raw }}

					{% if show_paywall_label %}
						<div class="absolute bottom-2 right-2 z-[2]">
							{% include 'styleguide/components/teasers/post/paywall-label.twig' %}
						</div>
					{% endif %}
				</div>
			{% endif %}

			<div class="lg:p-4">
				{% include 'styleguide/components/teasers/post/header.twig' with {
					useH3: useH3,
					url: url,
					title: title,
					categories: categories,
					genres: genres,
					sections: sections,
					date: date,
					small: true,
					show_paywall_label: show_paywall_label,
				} only %}

				{% if excerpt %}
					<div class="mt-3 text-base sm:text-[17px] sm:leading-6">
						{{ excerpt|raw }}
					</div>
				{% endif %}
			</div>

			{% include 'styleguide/components/teasers/post/footer.twig' with {
				title: title,
				authors: authors,
				comments: comments,
				url: url,
			} %}
		</div>
	</div>
</div>
