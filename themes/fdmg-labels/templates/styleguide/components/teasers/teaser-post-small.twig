<div class="teaser-post teaser-post--small">

	{# Mobile only #}
	<div class="sm:hidden">
		<div class="teaser-post__inner">
			<div class="flex gap-6 items-center">
				<div class="grow">
					{% include 'styleguide/components/teasers/post/header.twig' with {
						useH3: useH3,
						url: url,
						title: title,
						terms: terms,
					} only %}
				</div>

				{% if image_square %}
					<div class="shrink-0">
						<div class="teaser-post__square-thumbnail">
							{{ image_square|raw }}
						</div>
					</div>
				{% endif %}
			</div>
		</div>
	</div>

	{# Tablet only #}
	<div class="hidden sm:block lg:hidden">
		<div class="flex">

			{% if image %}
				<div class="shrink-0">
					<div class="teaser-post__thumbnail">
						{{ image|raw }}
					</div>
				</div>
			{% endif %}

			<div class="grow">
				<div class="teaser-post__inner">
					{% include 'styleguide/components/teasers/post/header.twig' with {
						useH3: useH3,
						url: url,
						title: title,
						terms: terms,
						date: date,
						datetime: datetime,
						date_full: date_full,
					} only %}
				</div>
			</div>
		</div>
	</div>

	{# Desktop only #}
	<div class="hidden lg:block teaser-post__desktop">
		<div class="teaser-post__desktop-inner">
			{% if image %}
				<div class="teaser-post__thumbnail">
					{{ image|raw }}
				</div>
			{% endif %}

			<div class="teaser-post__inner">
				{% include 'styleguide/components/teasers/post/header.twig' with {
					useH3: useH3,
					url: url,
					title: title,
					terms: terms,
					date: date,
					datetime: datetime,
					date_full: date_full,
				} only %}

				{% if excerpt %}
					<div class="teaser-post__excerpt">
						{{ excerpt|raw }}
					</div>
				{% endif %}
			</div>

			{% include 'styleguide/components/teasers/post/footer.twig' with {
				title: title,
				authors: authors,
				comments: comments,
				url: url,
			} %}
		</div>
	</div>
</div>
