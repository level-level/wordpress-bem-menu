{% set authors_string = authors|map(author => author.name)|join(', ') %}
{% set datalayer_config = {
	title: title,
	author: authors_string,
	id: article_id,
	publication_date: publication_date,
	publication_time: publication_time,
	revisions_count: revisions_count,
	article_index: article_index,
	component_subtype: component_subtype,
	categories: categories,
}|json_encode(constant('JSON_HEX_QUOT')) %}

<div data-component="teaser-post-wide" data-module="datalayer" data-type="article_impression" data-config="{{ datalayer_config }}" class="relative flex flex-col h-full transition-shadow border-b sm:border-b-2 font-figtree bg-base-50 border-secondary-400 theme-energeia:border-primary theme-pensioen-pro:border-primary dark:border-transparent dark:bg-base-600 hocus:shadow-teaser group/teaser">

	{# Mobile only #}
	<div class="sm:hidden">
		<div class="p-3 sm:p-4">
			<div class="flex items-center gap-6">
				<div class="grow">
					{% include 'styleguide/components/teasers/post/header.twig' with {
						useH3: useH3,
						url: url,
						title: title,
						categories: categories,
						genres: genres,
						sections: sections,
						wide: true,
						show_paywall_label: show_paywall_label,
						datalayer_config: datalayer_config,
					} only %}

					{% if show_paywall_label %}
						<div class="inline-flex mt-2 mb-1">
							{% include 'styleguide/components/teasers/post/paywall-label.twig' %}
						</div>
					{% endif %}
				</div>

				{% if image %}
					<div class="shrink-0">
						<div class="max-w-[65px]">
							{{ image|raw }}
						</div>
					</div>
				{% endif %}
			</div>
		</div>
	</div>

	{# Tablet >= #}
	<div class="hidden sm:block">
		<div class="p-3 sm:p-4">
			<div class="flex gap-6">
				<div class="grow">
					{% include 'styleguide/components/teasers/post/header.twig' with {
						useH3: useH3,
						url: url,
						title: title,
						categories: categories,
						genres: genres,
						sections: sections,
						date: date,
						wide: true,
						show_paywall_label: show_paywall_label,
					} only %}

					{% if excerpt %}
						<div class="mt-3 text-base sm:text-[17px] sm:leading-6">
							{{ excerpt|raw }}
						</div>
					{% endif %}
				</div>

				{% if image %}
					<div class="shrink">
						<div class="relative overflow-hidden aspect-[1/1] sm:w-[170px] image:w-full image:h-full image:object-cover">
							{{ image|raw }}

							{% if show_paywall_label %}
								<div class="absolute bottom-2 right-2 z-[2]">
									{% include 'styleguide/components/teasers/post/paywall-label.twig' %}
								</div>
							{% endif %}
						</div>
					</div>
				{% endif %}

			</div>
		</div>

		{% include 'styleguide/components/teasers/post/footer.twig' with {
			title: title,
			authors: authors,
			comments: comments,
			url: url,
		} %}
	</div>
</div>
