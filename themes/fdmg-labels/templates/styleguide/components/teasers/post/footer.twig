{% if not feature_manager.is_enabled(constant('FEATURE_DISABLE_ARTICLE_TEASER_FOOTER', feature_manager)) %}
	{% if authors or comments > 0 %}
		<div class="text-sm relative z-10 leading-none border-t border-[rgb(0,0,0,0.1)] p-3 mt-auto min-h-[47px] dark:border-base-800">
			<div class="flex items-center justify-between flex-nowrap">

				{% if authors %}
					<div>
						<span class="sr-only">
							{{ _x('Written by:', 'Screen reader text', 'fdmg-labels') }}
						</span>
						<ul class="flex gap-3">
							{% for object in authors %}
								<li>
									{% include 'styleguide/components/buttons/button-link.twig' with {
										text: object.name,
										url: object.url,
										class: 'btn-link',
									} %}
								</li>
							{% endfor %}
						</ul>
					</div>
				{% endif %}

				{% if comments > 0 %}
					<div class="shrink-0">
						<div class="flex items-center justify-between flex-nowrap">
							<div>
								{% include 'styleguide/components/buttons/button-link.twig' with {
									text: comments,
									url: url ~ '#comments',
									class: 'btn-link',
									aria_label: _n('%s comment on %s', '%s comments on %s', comments, 'fdmg-labels')|format(comments, title),
									icon: 'comment',
									icon_left: true,
								} %}
							</div>
						</div>
					</div>
				{% endif %}
			</div>
		</div>
	{% endif %}
{% endif %}
