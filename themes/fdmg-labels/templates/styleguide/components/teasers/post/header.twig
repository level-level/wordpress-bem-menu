{% set title_style = 'text-xl' %}
{% if large %}
	{% set title_style = 'text-xl sm:text-2xl' %}
{% elseif small %}
	{% set title_style = 'text-base sm:text-lg' %}
{% elseif wide %}
	{% set title_style = 'text-md sm:text-lg' %}
{% endif %}

<div class="flex flex-col">
	<div class="order-2 mt-2 sm:mt-3">
		<{{ useH3 ? 'h3' : 'h2' }} class="{{ title_style }}">
			<a href="{{ url }}" class="no-underline break-words transition-colors absolute-link hocus:text-primary theme-energeia:hocus:text-base-800 hocus:underline hocus:dark:text-primary-300 group-focus-within/teaser:text-primary group-focus-within/teaser:underline dark:group-focus-within/teaser:text-primary-300 theme-energeia:group-focus-within/teaser:text-base-800">
				{{ title|raw }}
			</a>
		</{{ useH3 ? 'h3' : 'h2' }}>
	</div>

	{% if categories or genres or sections or date.date and date.datetime and date.date_full %}
		<div data-component="terms" class="text-sm">
			<div class="flex items-center justify-between flex-nowrap">

				{% if categories or genres or sections %}
					<div class="flex gap-1">
						{% if categories %}
							{% include 'styleguide/components/post-terms.twig' with {
								terms: categories,
								label: _x('category', 'Screen reader text', 'fdmg-labels'),
							} %}
						{% endif %}

						{% if genres %}
							{% include 'styleguide/components/post-terms.twig' with {
								terms: genres,
								label: _x('genre', 'Screen reader text', 'fdmg-labels'),
							} %}
						{% endif %}

						{% if genres and sections %}
							<div class="leading-none text-md" aria-hidden="true">•</div>
						{% endif %}

						{% if sections %}
							{% include 'styleguide/components/post-terms.twig' with {
								terms: sections,
								label: _x('section', 'Screen reader text', 'fdmg-labels'),
							} %}
						{% endif %}
					</div>
				{% endif %}

				{% if date.datetime and date.date_full and date.readable %}
					<div class="shrink-0">
						<div class="text-sm text-secondary-700 dark:text-base-100">
							<time datetime="{{ date.datetime|raw }}">{{ date.readable|raw }}</time>
						</div>
					</div>
				{% endif %}
			</div>
		</div>
	{% endif %}
</div>
