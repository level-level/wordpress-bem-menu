<div data-component="teaser-post-large" class="relative flex flex-col h-full transition-shadow border-b-2 font-body bg-base-50 border-secondary-400 theme-energeia:border-primary dark:border-transparent dark:bg-base-600 hocus:shadow-teaser group/teaser">

	{% if image %}
		<div class="relative overflow-hidden aspect-video image:absolute image:top-1/2 image:left-1/2 image:-translate-x-1/2 image:-translate-y-1/2">
			{{ image|raw }}
		</div>
	{% endif %}

	<div class="p-3 sm:p-4">
		{% include 'styleguide/components/teasers/post/header.twig' with {
			useH3: useH3,
			url: url,
			title: title,
			categories: categories,
			genres: genres,
			sections: sections,
			date: date,
			large: true,
		} only %}

		{% if excerpt %}
			<div class="mt-3 text-base sm:text-md">
				{{ excerpt|raw }}
			</div>
		{% endif %}
	</div>

	{% include 'styleguide/components/teasers/post/footer.twig' with {
		title: title,
		authors: authors,
		comments: comments,
		url: url,
	} %}
</div>
