<div class="teaser-partner">
	<div class="teaser-partner__inner">
		<div class="flex flex-wrap gap-3 sm:flex-nowrap">

			<div class="basis-full sm:basis-auto sm:shrink-0 sm:order-2">
				<div class="teaser-partner__thumbnail">
					{% if image %}
						{{ image|raw }}
					{% endif %}
				</div>
			</div>

			<div class="basis-full sm:basis-auto">
				<div class="flex flex-col gap-3">
					<h3 class="teaser-partner__title">
						{{ title|raw }}
					</h3>

					{% if excerpt %}
						{{ excerpt|raw }}
					{% endif %}

					<div>
						{% include 'styleguide/components/buttons/button-link.twig' with {
							text: _x('View partner', 'Block', 'fdmg-labels'),
							url: url,
							class: 'btn--tertiary',
							aria_label: _x('View partner, %s', 'Screen reader text', 'fdmg-labels')|format(title),
							icon: 'arrow-right',
							icon_left: true,
							highlight_icon: true,
						} %}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
