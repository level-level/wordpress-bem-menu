<div data-teaser-post data-component="teaser-post-inline" {{ datalayer.get_config(object, 'TEASER', component_subtype) }} class="relative flex flex-col h-full transition-shadow border-b font-figtree bg-transparent border-secondary-400 dark:border-base-800 group/teaser {{ is_last_item ? '!border-0' }}">

	{# Mobile only #}
	<div class="sm:hidden">
		<div class="p-3 sm:p-4">
			<div class="flex items-center gap-6">
				<div class="grow">
					{% include 'styleguide/components/teasers/post/header.twig' with {
						useH3: useH3,
						url: url,
						title: title,
						categories: categories,
						genres: genres,
						sections: sections,
						wide: true,
						show_paywall_label: show_paywall_label,
					} only %}

					{% if show_paywall_label %}
						<div class="inline-flex mt-2 mb-1">
							{% include 'styleguide/components/teasers/post/paywall-label.twig' %}
						</div>
					{% endif %}
				</div>

				{% if image_square %}
					<div class="shrink-0">
						<div class="max-w-[65px]">
							{{ image_square|raw }}
						</div>
					</div>
				{% endif %}
			</div>
		</div>
	</div>

	{# Tablet >= #}
	<div class="hidden sm:block">
		<div class="p-3 sm:px-0">
			<div class="flex items-center gap-6">
				<div class="grow">
					{% include 'styleguide/components/teasers/post/header.twig' with {
						useH3: useH3,
						url: url,
						title: title,
						categories: categories,
						genres: genres,
						sections: sections,
						wide: true,
						show_paywall_label: show_paywall_label,
					} only %}

					{% if show_paywall_label %}
						<div class="inline-flex mt-2 mb-1">
							{% include 'styleguide/components/teasers/post/paywall-label.twig' %}
						</div>
					{% endif %}
				</div>

				{% if image %}
					<div class="shrink-0">
						<div class="sm:relative sm:overflow-hidden sm:aspect-[14/9] sm:w-[155px] image:w-full image:h-full image:object-cover">
							{{ image|raw }}
						</div>
					</div>
				{% endif %}

			</div>
		</div>
	</div>
</div>
