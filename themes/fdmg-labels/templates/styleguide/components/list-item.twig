<div data-teaser-post data-component="list-item" {{ datalayer.get_config(object, 'TEASER', component_subtype) }} class="relative flex flex-col w-full">

	{% if comment_content %}
		<div class="order-2 mb-2 text-base">
			<a href="{{ url }}" class="relative order-2 block pr-8 text-base no-underline break-words hocus:text-primary hocus:underline hocus:dark:text-primary-300 absolute-link theme-energeia:hocus:text-base-800">
				<span class="block mb-2">{{ comment_author ? _x('%s commented on %s:', 'Comments', 'fdmg-labels')|format(comment_author, title)|raw }}</span>

				{% set max_length = 80 %}
				{% set truncated_comment = comment_content|length > max_length ? comment_content|slice(0, max_length) ~ '...' : comment_content %}
				<span>"{{ truncated_comment }}"</span>

				<div class="absolute right-0 -translate-y-1/2 top-1/2">
					<span class="text-[11px] icon-inline" aria-hidden="true">{{ svg_icons.get('chevron-right')|raw }}</span>
				</div>
			</a>
		</div>
	{% else %}
		<a href="{{ url }}" class="relative order-2 block pr-8 text-base no-underline break-words hocus:text-primary hocus:underline hocus:dark:text-primary-300 absolute-link theme-energeia:hocus:text-base-800">
			{{ title|raw }}

			<div class="absolute right-0 -translate-y-1/2 top-1/2">
				<span class="text-[11px] icon-inline" aria-hidden="true">{{ svg_icons.get('chevron-right')|raw }}</span>
			</div>
		</a>
	{% endif %}

	{% if comment_count %}
		<div class="order-2 mt-2 text-sm text-secondary-700 dark:text-base-100">
			<div class="flex items-center gap-2 text-sm">
				<span class="icon-inline" aria-hidden="true">{{ svg_icons.get('comment')|raw }}</span>
				{% if comment_count is same as(1) %}
					<span>{{ _x('%s comment', 'Comments', 'fdmg-labels')|format(comment_count) }}</span>
				{% else %}
					<span>{{ _x('%s comments', 'Comments', 'fdmg-labels')|format(comment_count) }}</span>
				{% endif %}
			</div>
		</div>
	{% endif %}

	{% if datetime and date or terms %}
		<div class="text-sm text-secondary-700 mb-[5px] dark:text-base-100">
			<div class="flex gap-6 flex-nowrap">

				{% if terms %}
					<div class="grow">
						{% include 'styleguide/components/post-terms.twig' with {
							terms: terms,
							label: term_label,
						} %}
					</div>
				{% endif %}

				{% if datetime and date %}
					<div class="shrink-0 theme-fd:text-base-600">
						<span class="sr-only">{{ _x('Published:', 'Screen reader text', 'fdmg-labels') }}</span>
						<time datetime="{{ datetime|raw }}">{{ date|raw }}</time>
					</div>
				{% endif %}
			</div>
		</div>
	{% endif %}
</div>
