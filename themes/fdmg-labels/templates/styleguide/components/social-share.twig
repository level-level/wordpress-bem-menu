{% if socials %}
	<div class="social-share {{ sticky ? 'social-share--sticky' }}" {{ sticky ? 'aria-hidden="true"' }}>
		<div class="flex flex-col gap-3">

			{% if heading %}
				<p class="social-share__heading h4">{{ heading|raw }}</p>
			{% endif %}

			{% if socials %}
				<ul class="list-social-share {{ sticky ? 'list-social-share--vertical' }}" data-module="social-share">
					{% for social in socials %}
						<li class="list-social-share__item">

							{% set args = {
								text: '',
								class: 'btn--share js--share',
								icon: social.type,
								data_config: '{"type": "' ~ social.type ~ '", "shareText": "' ~ share_text ~ '"}',
								aria_label: _x('%1$s share — This button opens a share-on-%1$s dialog in a new window.', 'Screen reader text', 'fdmg-labels')|format(social.title),
								focusable: sticky ? false,
							} %}

							{% if social.type == 'email' %}
								{% set args = args|merge({
									url: 'javascript:void(0);',
									aria_label: _x('%1$s share — This opens your e-mail client.', 'Screen reader text', 'fdmg-labels')|format(social.title),
								}) %}
								{% include 'styleguide/components/buttons/button-link.twig' with args %}
							{% else %}
								{% include 'styleguide/components/buttons/button-element.twig' with args %}
							{% endif %}
						</li>
					{% endfor %}
				</ul>
			{% endif %}
		</div>
	</div>
{% endif %}
