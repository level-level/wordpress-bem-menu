{% if most_read or latest %}
	<div data-component="tabbed-posts" class="border-b-2 border-secondary-400 dark:border-transparent theme-energeia:border-primary theme-pensioen-pro:border-primary theme-fd:border-secondary-400" data-module="tabs">
		<ul class="flex flex-nowrap border-b border-[rgb(0,0,0,0.1)] dark:border-base-800" role="tablist">

			{% set most_read_button_element %}
				{% if most_read %}
					<li role="presentation" class="grow js-item {{ show_latest_articles_first ? 'order-2' }}">
						<a role="tab" href="#most-read" id="tab1" class="font-bold text-base text-center relative block py-4 px-4 pb-[calc(15px-4px)] bg-base-50 no-underline border-b-4 border-transparent text-primary transition-colors dark:text-primary-300 dark:bg-base-600 hocus:bg-secondary-100 hocus:underline hocus:dark:bg-base-400 hocus:dark:text-primary-300 aria-selected:border-primary aria-selected:text-primary aria-selected:dark:border-primary-300 aria-selected:dark:text-primary-300 aria-selected:hocus:bg-base-50 aria-selected:hocus:no-underline aria-selected:hocus:dark:bg-base-600 theme-energeia:text-base-800 aria-selected:cursor-auto hocus:z-[1] js-link theme-fd:bg-paper-50 theme-fd:font-proxima theme-fd:text-base-600 theme-fd:border-secondary-400" {{ not show_latest_articles_first ? 'aria-selected="true"' }}>
							{{ most_read_posts_title|default(_x('Most read', 'Block', 'fdmg-labels')) }}
						</a>
					</li>
				{% endif %}
			{% endset %}

			{% set latest_articles_button_element %}
				{% if latest %}
					<li role="presentation" class="grow js-item">
						<a role="tab" href="#latest" id="tab2" class="font-bold text-base text-center relative block py-4 px-4 pb-[calc(15px-4px)] bg-base-50 no-underline border-b-4 border-transparent text-primary transition-colors dark:text-primary-300 dark:bg-base-600 hocus:bg-secondary-100 hocus:underline hocus:dark:bg-base-400 hocus:dark:text-primary-300 aria-selected:border-primary aria-selected:text-primary aria-selected:dark:border-primary-300 aria-selected:dark:text-primary-300 aria-selected:hocus:bg-base-50 aria-selected:hocus:no-underline aria-selected:hocus:dark:bg-base-600 theme-energeia:text-base-800 aria-selected:cursor-auto hocus:z-[1] js-link theme-fd:bg-paper-50 theme-fd:font-proxima theme-fd:text-base-600 theme-fd:border-secondary-400" {{ show_latest_articles_first or not most_read ? 'aria-selected="true"' }}>
							{{ latest_posts_title|default(_x('Latest articles', 'Block', 'fdmg-labels')) }}
						</a>
					</li>
				{% endif %}
			{% endset %}

			{% if show_latest_articles_first %}
				{{ latest_articles_button_element }}
				{{ most_read_button_element }}
			{% else %}
				{{ most_read_button_element }}
				{{ latest_articles_button_element }}
			{% endif %}

		</ul>

		{% if most_read %}
			<div id="most-read" class="block bg-base-50 dark:bg-base-600 aria-hidden:hidden js-section theme-fd:bg-paper-50" {{ show_latest_articles_first ? 'aria-hidden="true"' }}>
				{% include 'styleguide/components/most-read-articles.twig' with {
					objects: most_read ? most_read|map(post => {
						title: post.get_alternative_title()|default(post.get_title()),
						url: post.get_permalink(),
						object: post,
					}),
				} %}
			</div>
		{% endif %}

		{% if latest %}
			<div id="latest" class="block bg-base-50 dark:bg-base-600 aria-hidden:hidden js-section theme-fd:bg-paper-50" {{ show_latest_articles_first or not most_read ? 'aria-hidden="false"' : 'aria-hidden="true"' }}>
				{% include 'styleguide/components/list-component.twig' with {
					objects: latest ? latest|map(post => {
						title: post.get_alternative_title()|default(post.get_title()),
						url: post.get_permalink(),
						terms: show_terms ? (post.get_terms(feature_manager.is_enabled(constant('FEATURE_ENABLE_GENRE_TAXONOMY', feature_manager)) ? 'fdmg_genre' : 'category')|map(term => {
							name: term.get_name(),
						})),
						term_label: show_terms ? (feature_manager.is_enabled(constant('FEATURE_ENABLE_GENRE_TAXONOMY', feature_manager)) ? _x('genre', 'Screen reader text', 'fdmg-labels') : _x('category', 'Screen reader text', 'fdmg-labels')),
						date: post.get_human_readable_date(),
						datetime: post.get_date_i18n('Y-m-d'),
						post: post,
					}),
					button_text: latest_button_title|default(_x('More articles', 'Block', 'fdmg-labels')),
					button_link: get_post_type_archive_link('post'),
				} %}
			</div>
		{% endif %}
	</div>
{% endif %}
