{% if most_read or latest %}
	<div data-component="tabbed-posts" class="border-b-2 border-secondary-400 dark:border-transparent" data-module="tabs">
		<ul class="flex flex-nowrap border-b border-[rgb(0,0,0,0.1)] dark:border-base-800" role="tablist">

			{% if most_read %}
				<li role="presentation" class="grow js-item">
					<a role="tab" href="#most-read" id="tab1" class="font-body-bold text-base text-center relative block py-4 px-4 pb-[calc(15px-4px)] bg-base-50 no-underline border-b-4 border-transparent text-primary transition-colors dark:text-primary-300 dark:bg-base-600 hocus:bg-secondary-100 hocus:underline hocus:dark:bg-base-400 hocus:dark:text-primary-300 aria-selected:border-primary aria-selected:text-primary aria-selected:dark:border-primary-300 aria-selected:dark:text-primary-300 aria-selected:hocus:bg-base-50 aria-selected:hocus:no-underline aria-selected:hocus:dark:bg-base-600 theme-energeia:text-base-800 aria-selected:cursor-auto hocus:z-[1] js-link" aria-selected="true">
						{{ _x('Most read', 'Block', 'fdmg-labels') }}
					</a>
				</li>
			{% endif %}

			{% if latest %}
				<li role="presentation" class="grow js-item">
					<a role="tab" href="#latest" id="tab2" class="font-body-bold text-base text-center relative block py-4 px-4 pb-[calc(15px-4px)] bg-base-50 no-underline border-b-4 border-transparent text-primary transition-colors dark:text-primary-300 dark:bg-base-600 hocus:bg-secondary-100 hocus:underline hocus:dark:bg-base-400 hocus:dark:text-primary-300 aria-selected:border-primary aria-selected:text-primary aria-selected:dark:border-primary-300 aria-selected:dark:text-primary-300 aria-selected:hocus:bg-base-50 aria-selected:hocus:no-underline aria-selected:hocus:dark:bg-base-600 theme-energeia:text-base-800 aria-selected:cursor-auto hocus:z-[1] js-link" tabindex="-1" {{ not most_read ? 'aria-selected="true"' }}>
						{{ _x('Latest articles', 'Block', 'fdmg-labels') }}
					</a>
				</li>
			{% endif %}
		</ul>

		{% if most_read %}
			<div id="most-read" class="block bg-base-50 dark:bg-base-600 aria-hidden:hidden js-section" aria-hidden="false">
				{% include 'styleguide/components/most-read-articles.twig' with {
					objects: most_read ? most_read|map(post => {
						title: post.get_alternative_title()|default(post.get_title()),
						url: post.get_permalink(),
					}),
				} %}
			</div>
		{% endif %}

		{% if latest %}
			<div id="latest" class="block bg-base-50 dark:bg-base-600 aria-hidden:hidden js-section" {{ not most_read ? 'aria-hidden="false"' : 'aria-hidden="true"' }}>
				{% include 'styleguide/components/list-component.twig' with {
					objects: latest ? latest|map(post => {
						title: post.get_alternative_title()|default(post.get_title()),
						url: post.get_permalink(),
						terms: post.get_terms(feature_manager.is_enabled(constant('FEATURE_ENABLE_GENRE_TAXONOMY', feature_manager)) ? 'fdmg_genre' : 'category')|map(term => {
							name: term.get_name(),
						}),
						term_label: feature_manager.is_enabled(constant('FEATURE_ENABLE_GENRE_TAXONOMY', feature_manager)) ? _x('genre', 'Screen reader text', 'fdmg-labels') : _x('category', 'Screen reader text', 'fdmg-labels'),
						date: post.get_date_i18n(get_option('time_format')),
						datetime: post.get_date_i18n('H:i'),
						date_full: post.get_date_i18n(get_option('time_format')),
					}),
					button_text: _x('More articles', 'Block', 'fdmg-labels'),
					button_link: get_post_type_archive_link('post'),
				} %}
			</div>
		{% endif %}
	</div>
{% endif %}
