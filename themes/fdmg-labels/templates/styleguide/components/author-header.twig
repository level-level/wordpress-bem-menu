{% if title or label %}
	<div data-component="author-header" class="relative">
		<div class="flex flex-col gap-3">

			{% if label %}
				<ul class="flex gap-1">
					<li>
						{% include 'styleguide/components/badges/badge.twig' with {
							title: label,
							rich: true,
						} %}
					</li>
				</ul>
			{% endif %}

			{% if title %}
				<h1 class="rich-title">{{ title|raw }}</h1>
			{% endif %}
		</div>
	</div>
{% endif %}
