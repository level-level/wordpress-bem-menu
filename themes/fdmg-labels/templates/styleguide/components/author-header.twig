{% if title or label %}
	<div data-component="author-header" class="relative">
		<div class="flex flex-col gap-3">

			{% if label %}
				<ul class="flex gap-1">
					<li>
						{% include 'styleguide/components/badges/badge.twig' with {
							title: label,
							rich: true,
						} %}
					</li>
				</ul>
			{% endif %}

			{% if title %}
				<h1 class="pb-3 text-lg font-bold border-b-4 font-libre sm:text-3xl text-primary theme-energeia:text-base-500 theme-pensioen-pro:text-base-500 border-secondary-400 dark:text-primary-300 dark:border-primary-300 theme-fd:border-none theme-fd:text-base-600 theme-fd:dark:text-paper-50 theme-fd:font-proxima theme-bnr:font-jakarta theme-bnr:border-none theme-bnr:text-base-800">{{ title|raw }}</h1>
			{% endif %}
		</div>
	</div>
{% endif %}
