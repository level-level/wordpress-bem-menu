<div data-component="bio" class="relative text-base sm:text-[17px] sm:leading-6 font-normal bg-secondary-100 dark:bg-base-600">
	<div class="p-3 sm:p-4">
		<div class="flex flex-col gap-3">

			{% if image %}
				<div class="image:rounded-full image:max-w-[80px]">
					{{ image|raw }}
				</div>
			{% endif %}

			{% if logo %}
				<div class="pt-3 pb-6 bg-transparent dark:bg-base-50 image:max-w-[200px] image:mx-auto">
					{{ logo|raw }}
				</div>
			{% endif %}

			{% if title %}
				<h3 class="text-base font-bold font-figtree text-primary dark:text-primary-300 theme-energeia:text-base-800 sm:text-md">
					{{ title|raw }}
				</h3>
			{% endif %}

			{% if subtitle %}
				<h3 class="text-base font-bold text-primary dark:text-primary-300 sm:text-md">
					{{ subtitle|raw }}
				</h3>
			{% endif %}

			{% if excerpt %}
				{{ excerpt|raw }}
			{% endif %}
		</div>
	</div>

	{% if email or linkedin %}
		<div class="border-t border-[rgb(0,0,0,0.1)] dark:border-base-800">
			<div class="p-3 sm:p-4">
				<ul class="flex flex-col gap-3">

					{% if email %}
						<li>
							{% include 'styleguide/components/buttons/button-link.twig' with {
								text: _x('E-mail', 'Block', 'fdmg-labels'),
								url: 'mailto:' ~ email,
								class: 'btn-primary btn-full',
								is_external: false,
								aria_label: _x('E-mail, send %s an e-mail', 'Screen reader text', 'fdmg-labels')|format(title),
								icon: 'email',
								icon_left: true,
							} %}
						</li>
					{% endif %}

					{% if linkedin %}
						<li>
							{% include 'styleguide/components/buttons/button-link.twig' with {
								text: _x('LinkedIn', 'Block', 'fdmg-labels'),
								url: linkedin,
								class: 'btn-primary btn-full',
								is_external: false,
								aria_label: _x('LinkedIn, visit %s\'s LinkedIn profile', 'Screen reader text', 'fdmg-labels')|format(title),
								icon: 'linkedin',
								icon_left: true,
							} %}
						</li>
					{% endif %}
				</ul>
			</div>
		</div>
	{% endif %}
</div>
