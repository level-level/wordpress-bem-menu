<div class="bio">
	<div class="bio__inner">
		<div class="flex flex-col gap-3">

			{% if image %}
				<div class="bio__thumbnail">
					{{ image|raw }}
				</div>
			{% endif %}

			{% if logo %}
				<div class="bio__logo">
					{{ logo|raw }}
				</div>
			{% endif %}

			{% if title %}
				<h3 class="bio__title">
					{{ title|raw }}
				</h3>
			{% endif %}

			{% if subtitle %}
				<h3 class="bio__subtitle">
					{{ subtitle|raw }}
				</h3>
			{% endif %}

			{% if excerpt %}
				{{ excerpt|raw }}
			{% endif %}
		</div>
	</div>

	{% if email or linkedin %}
		<div class="bio__footer">
			<div class="bio__inner">
				<ul class="flex flex-col gap-3">

					{% if email %}
						<li>
							{% include 'styleguide/components/buttons/button-link.twig' with {
								text: _x('E-mail', 'Block', 'fdmg-labels'),
								url: 'mailto:' ~ email,
								class: 'btn--primary btn--full',
								is_external: false,
								aria_label: _x('E-mail, send %s an e-mail', 'Screen reader text', 'fdmg-labels')|format(title),
								icon: 'email',
								icon_left: true,
							} %}
						</li>
					{% endif %}

					{% if linkedin %}
						<li>
							{% include 'styleguide/components/buttons/button-link.twig' with {
								text: _x('LinkedIn', 'Block', 'fdmg-labels'),
								url: linkedin,
								class: 'btn--primary btn--full',
								is_external: false,
								aria_label: _x('LinkedIn, visit %s\'s LinkedIn profile', 'Screen reader text', 'fdmg-labels')|format(title),
								icon: 'linkedin',
								icon_left: true,
							} %}
						</li>
					{% endif %}
				</ul>
			</div>
		</div>
	{% endif %}
</div>
