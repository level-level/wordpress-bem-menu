{% if title and url %}
	<a href="{{ url }}" class="relative block text-sm font-bold border-2 sm:text-base hocus:text-base-800 hocus:dark:text-primary-300 bg-primary border-primary text-base-50 no-underline py-1 px-[10px] dark:bg-primary-300 dark:border-primary-300 dark:text-base-800 hocus:bg-transparent hocus:dark:bg-transparent transition-[background,color] theme-energeia:dark:text-base-700 hocus:theme-energeia:dark:text-base-50" data-component="badge">
		{{ title|raw }}
	</a>
{% elseif title %}
	<div class="relative text-sm font-bold text-primary dark:text-primary-300 sm:text-base" data-component="badge">
		{{ title|raw }}
	</div>
{% endif %}
