<div class="form-group__item">
	<label for="email">
		{{ _x('E-mail', 'Comments', 'fdmg-labels') }}
		<span class="required">*</span>
	</label>
	<input
		autocomplete="email"
		id="email"
		name="email"
		type="email"
		value="{{ email }}"
		size="30"
		maxlength="100"
		required="required"
	>
</div>
