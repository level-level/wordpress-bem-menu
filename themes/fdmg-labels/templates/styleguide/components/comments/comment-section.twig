{% if object.has_comments_enabled() %}
	<div class="section">
		<div class="flex flex-col gap-3">

			{% set comment_count = object.get_comments_count() %}
			{% if comment_count > 0 %}
				<div id="comments" class="pt-[calc(theme(space.header-height)+theme(space.admin-bar)+theme(space.6))] -mt-[calc(theme(space.header-height)+theme(space.admin-bar)+theme(space.6))]">
					<div class="relative border-b-2 bg-secondary-200 border-secondary-400 dark:bg-base-600 dark:border-transparent">
						<div class="px-3 py-3 border-b border-secondary-400 dark:border-base-800 sm:px-6">
							<h2 class="font-body-bold text-md text-primary dark:text-primary-300 sm:text-lg">
								{{ _n('%s Comment', '%s Comments', comment_count, 'fdmg-labels')|format(comment_count) }}
							</h2>
						</div>
						<ol>
							{{ object.display_comments() }}
						</ol>
					</div>
				</div>
			{% endif %}

			<div class="comment-form-container">
				{{ object.get_comment_form() }}
			</div>
		</div>
	</div>
{% endif %}
