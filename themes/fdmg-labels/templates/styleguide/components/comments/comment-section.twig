{% if object.has_comments_enabled() %}
	<div class="section">
		<div class="flex flex-col gap-3">

			{% set comment_count = object.get_comments_count() %}
			{% if comment_count > 0 %}
				<div id="comments" class="pt-[calc(theme(space.header-height)+theme(space.admin-bar)+theme(space.6))] -mt-[calc(theme(space.header-height)+theme(space.admin-bar)+theme(space.6))]">
					<div class="relative border-b-2 bg-secondary-100 border-secondary-400 dark:bg-base-600 dark:border-transparent theme-fd:bg-paper-50">
						<div class="px-3 py-3 border-b border-secondary-400 dark:border-base-800 sm:px-6 theme-fd:border-paper-300">
							<h2 class="font-bold font-figtree text-md text-primary dark:text-primary-300 sm:text-lg theme-energeia:text-base-800 theme-fd:font-proxima">
								{{ _nx('%d comment', '%d comments', comment_count, 'Comment', 'fdmg-labels')|format(comment_count) }}
							</h2>
						</div>
						<ol>
							{{ object.display_comments() }}
						</ol>
					</div>
				</div>
			{% endif %}

			{% set config = {
				post_id: object.get_id(),
			} %}
			<div id="comment-form" class="comment-form-container print:hidden" data-module="comment-form" data-config="{{ config|json_encode() }}">

				{% set login_url = static_pages.login.get_login_permalink(object.get_permalink()) %}
				{% set subscribe_url = options.subscribe_button.url %}
				{% include 'styleguide/components/comments/comment-no-permission.twig' with {
					login_url: login_url,
					subscribe_url: subscribe_url,
				} %}


				{# Comment form will be rendered here by api #}
			</div>
		</div>
	</div>
{% endif %}
