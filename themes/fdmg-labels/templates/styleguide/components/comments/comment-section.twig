{% if object.has_comments_enabled() %}
	<div class="section">
		<div class="flex flex-col gap-3">

			{% set comment_count = object.get_comments_count() %}
			{% if comment_count > 0 %}
				<div id="comments" class="pt-[calc(theme(space.header-height)+theme(space.admin-bar)+theme(space.6))] -mt-[calc(theme(space.header-height)+theme(space.admin-bar)+theme(space.6))]">
					<div class="relative border-b-2 bg-secondary-100 border-secondary-400 dark:bg-base-600 dark:border-transparent">
						<div class="px-3 py-3 border-b border-secondary-400 dark:border-base-800 sm:px-6">
							<h2 class="font-bold font-figtree text-md text-primary dark:text-primary-300 sm:text-lg theme-energeia:text-base-800">
								{{ _nx('%d comment', '%d comments', comment_count, 'Comment', 'fdmg-labels')|format(comment_count) }}
							</h2>
						</div>
						<ol>
							{{ object.display_comments() }}
						</ol>
					</div>
				</div>
			{% endif %}

			{% set config = {
				post_id: object.get_id(),
			} %}
			<div class="comment-form-container" data-module="comment-form" data-config="{{ config|json_encode() }}">

				{% set login_url = static_pages.auth.get_permalink(constant('PAGE_LOGIN', static_pages.auth)) %}
				{% set subscribe_url = options.subscribe_button.url %}
				<p class="px-3 py-3 text-base sm:px-6">
					{{ _x('You must be <a href="%s" class="hocus:text-primary hocus:no-underline hocus:dark:text-primary-300 theme-energeia:hocus:text-base-800">logged in</a> and have a <a href="%s" class="hocus:text-primary hocus:dark:text-primary-300 theme-energeia:hocus:text-base-800 hocus:no-underline">valid subscription</a> to post a comment.', 'Comments', 'fdmg-labels')|format(login_url, subscribe_url)|raw }}
				</p>
				{# Comment form will be rendered here by api #}
			</div>
		</div>
	</div>
{% endif %}
