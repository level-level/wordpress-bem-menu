{% include 'defaults/head.twig' %}

<main class="main" id="main-content">

	{% if is_active_sidebar('widget-area-header-ad') %}
		<div class="top-advertisement">
			{{ sidebar.get_widgetarea('widget-area-header-ad')|raw }}
		</div>
	{% endif %}

	{% block header %}{% endblock %}

	<div class="section section--no-top">
		<div class="container">
			<div class="md:flex md:flex-nowrap md:gap-6 md:justify-between">
				<div class="md:grow">
					<div class="section-wrapper">
						{% block content %}{% endblock %}
					</div>
				</div>
				<div class="md:w-[theme(space.sidebar-width)] md:shrink-0">
					<aside data-component="sidebar" class="h-full" data-module="sticky-advertisement">
						<h2 class="sr-only">
							{{ _x('Additional', 'Screen reader text', 'fdmg-labels') }}
						</h2>
						<div class="h-full section-wrapper">
							{% block sidebar %}{% endblock %}
						</div>
					</aside>
				</div>
			</div>
		</div>
	</div>
</main>

{% include 'defaults/footer.twig' %}
