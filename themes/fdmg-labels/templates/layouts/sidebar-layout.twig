{% include 'defaults/head.twig' %}

<main class="main" id="main-content">

	{% if is_active_sidebar('widget-area-header-ad') %}
		<div class="top-advertisement">
			{{ sidebar.get_widgetarea('widget-area-header-ad')|raw }}
		</div>
	{% endif %}

	<div class="section section--no-top">
		<div class="container">
			<div class="md:flex md:flex-nowrap md:gap-6">

				{% if block('offset') is defined and not is_front_page() %}
					<div class="hidden lg:shrink-0 lg:mb-[96px] lg:block">
						{% block offset %}{% endblock %}
					</div>
				{% endif %}

				{% if block('responsibility') is defined %}
					{% block responsibility %}{% endblock %}
				{% endif %}

				<div class="md:grow {{ not is_front_page() ? 'lg:max-w-[theme(space.article-width)] lg:mx-[theme(space.article-offset)]' }}">
					<div class="section-wrapper">
						{% block header %}{% endblock %}
						{% block content %}{% endblock %}
					</div>
				</div>
				<div class="md:w-[theme(space.sidebar-width)] md:shrink-0">
					<aside data-component="sidebar" class="h-full">
						<h2 class="screen-reader-text">
							{{ _x('Additional', 'Screen reader text', 'fdmg-labels') }}
						</h2>
						<div class="section-wrapper">
							{% block sidebar %}{% endblock %}
						</div>
					</aside>
				</div>
			</div>
		</div>
	</div>
</main>

{% include 'defaults/footer.twig' %}
