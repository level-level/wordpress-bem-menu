{% extends 'layouts/sidebar-layout-with-header.twig' %}

{% block header %}
	<div class="section">
		<div class="container">
			<div class="w-full md:w-[calc(100%-theme(space.sidebar-width)-theme(space.5))]">
				<h1 class="font-bold font-heading text-[26px] leading-9 sm:text-[40px] sm:leading-[3.5rem] lg:text-[48px] lg:leading-[3.875rem] pb-3 border-b-4 text-primary theme-energeia:text-base-800 border-secondary-400 dark:text-primary-300 dark:border-primary-300">{{ get_the_title(get_option('page_for_posts', true))|raw }}</h1>
			</div>
		</div>
	</div>
{% endblock %}

{% block content %}
	{% if objects %}
		<div class="section">
			<ul class="flex flex-col gap-3 sm:gap-6">
				{% set date_format = get_option('date_format') %}

				{% for object in objects %}

					{% set image_id = object.get_thumbnail_id() %}
					{% set terms = object.get_terms(feature_manager.is_enabled(constant('FEATURE_ENABLE_GENRE_TAXONOMY', feature_manager)) ? 'fdmg_genre' : 'category') %}
					{% set authors = object.get_authors() %}

					<li>
						{% include 'styleguide/components/teasers/teaser-post-wide.twig' with {
							image: image_id ? wp_get_attachment_image(image_id, 'large'),
							image_square: image_id ? wp_get_attachment_image(image_id, 'thumbnail'),
							title: object.get_alternative_title()|default(object.get_title()),
							url: object.get_permalink(),
							excerpt: object.get_excerpt(),
							date: object.get_date_i18n(date_format),
							date_full: object.get_date_i18n('F j Y'),
							datetime: object.get_date_i18n('Y-m-d'),
							terms: terms ? terms|map(term => {
								name: term.get_name(),
							}),
							authors: authors ? authors|map(author => {
								name: author.get_title(),
								location: author.get_location(),
								url: author.get_permalink(),
							}),
							comments: object.get_comments_count(),
						} %}
					</li>
				{% endfor %}
			</ul>
		</div>

		{% include 'partials/components/pagination.twig' %}
	{% endif %}
{% endblock %}

{% block sidebar %}

{% endblock %}

