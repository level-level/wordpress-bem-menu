{% extends 'archive.twig' %}

{% block header %}
	<div class="section" {{ datalayer.get_config(object, 'PAGEVIEW') }}>
		<div class="container">
			<div class="w-full md:w-[calc(100%-theme(space.sidebar-width)-theme(space.5))]">
				<h1 class="pb-3 text-lg font-bold border-b-4 font-libre sm:text-3xl text-primary theme-energeia:text-base-500 theme-pensioen-pro:text-base-500 border-secondary-400 dark:text-primary-300 dark:border-primary-300">{{ single_cat_title() ? single_cat_title() : post_type.get_archive_title() }}</h1>

				{% set term_description = term.get_description() %}
				{% if term_description %}
					<div class="pt-3 space-y-4">{{ wpautop(term_description)|raw }}</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}

{% block sidebar %}
	{% if is_active_sidebar('widget-area-section') %}
		{{ sidebar.get_widgetarea('widget-area-section')|raw }}
	{% endif %}
{% endblock %}
