	<footer>
		<div class="relative font-normal py-9 bg-secondary-300 dark:bg-base-400 lg:py-12">
			<div class="container">
				<div class="mb-6 max-w-[224px] sm:mb-12 lg:max-w-none">
					<a
						class="inline-block"
						href="{{ esc_url(home_url('/')) }}"
						aria-label="{{ _x('%s logo, go to the homepage', 'Screen reader text', 'fdmg-labels')|format(get_bloginfo('name'))|raw }}"
					>
						{% set logo_url = 'images/logo-' ~ options.active_theme ~ '-white.svg' %}
						<img
							src='{{ assets.get_assets_directory_url() }}/{{ logo_url}}'
							width="230"
							height="66"
							alt=""
						/>
					</a>
				</div>
			</div>
			<nav aria-labelledby="footer-heading">
				<h2 class="screen-reader-text" id="footer-heading">{{ _x('Important links', 'Screen reader text', 'fdmg-labels') }}</h2>
				<div class="container">
					<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-4">
						{% if has_nav_menu('about_navigation') %}
							<div>
								<h3 class="mb-3 text-lg font-body-bold text-secondary-600 dark:text-primary-300">{{ wp_get_nav_menu_name('about_navigation')|raw }}</h3>
								{{ bem_menu('about_navigation', 'footer-nav') }}
							</div>
						{% endif %}
						{% if has_nav_menu('general_navigation') %}
							<div>
								<h3 class="mb-3 text-lg font-body-bold text-secondary-600 dark:text-primary-300">{{ wp_get_nav_menu_name('general_navigation')|raw }}</h3>
								{{ bem_menu('general_navigation', 'footer-nav') }}
							</div>
						{% endif %}
						{% if has_nav_menu('services_navigation') %}
							<div>
								<h3 class="mb-3 text-lg font-body-bold text-secondary-600 dark:text-primary-300">{{ wp_get_nav_menu_name('services_navigation')|raw }}</h3>
								{{ bem_menu('services_navigation', 'footer-nav') }}
							</div>
						{% endif %}
						{% if has_nav_menu('fdmg_navigation') %}
							<div>
								<h3 class="mb-3 text-lg font-body-bold text-secondary-600 dark:text-primary-300">{{ wp_get_nav_menu_name('fdmg_navigation')|raw }}</h3>
								{{ bem_menu('fdmg_navigation', 'footer-nav') }}
							</div>
						{% endif %}
					</div>

					{% if options.enable_sourcepoint_cmp %}
						<button
							class="btn btn--link !text-secondary-600 dark:!text-base-50 hocus:underline"
							onclick="window._sp_.gdpr.loadPrivacyManagerModal(656244, 'purposes')"
							aria-label="{{ _x('Privacy Settings, open cookie preference dialog', 'Screen reader text', 'fdmg-labels') }}"
						>
							{{ _x('Privacy Settings', 'Block', 'fdmg-labels') }}
						</button>
					{% endif %}
				</div>
			</nav>
		</div>
		<div class="py-6 border-t border-secondary-400 bg-secondary-300 dark:border-base-800 dark:bg-base-400 lg:py-9">
			<div class="container">
				<h3 class="mb-3 font-body-bold text-md text-secondary-600 dark:text-primary-300 lg:text-lg">{{ _x('Follow us on social media', 'Social', 'fdmg-labels') }}</h3>
				{% include 'styleguide/components/social-media-links.twig' with {
					socials: [
						{
							title: 'Facebook',
							url: socials.facebook_site,
							icon: 'facebook',
						},
						{
							title: 'Twitter',
							url: socials.twitter ? 'https://twitter.com/' ~ socials.twitter_site,
							icon: 'twitter',
						},
						{
							title: 'LinkedIn',
							url: socials.linkedin_url,
							icon: 'linkedin',
						},
						{
							title: 'YouTube',
							url: socials.youtube_url,
							icon: 'youtube',
						}
					]
				} %}
			</div>
		</div>

	</footer>
{{ wp_footer() }}
</body>
</html>
