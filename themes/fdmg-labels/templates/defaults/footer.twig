	<footer class="print:hidden">
		<div class="relative font-normal py-9 bg-secondary-300 dark:bg-base-400 theme-energeia:bg-secondary-200 theme-pensioen-pro:bg-secondary-200 lg:py-12 space-y-">
			<div class="container mb-6 sm:mb-12">
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-4">
					<div class="max-w-[224px] lg:max-w-none">
						<a
							data-component="Logo"
							href="{{ esc_url(home_url('/')) }}"
							class="inline-block"
							aria-label="{{ _x('%s logo, go to the homepage', 'Screen reader text', 'fdmg-labels')|format(get_bloginfo('name'))|raw }}"
						>
							<span
								class="block bg-no-repeat bg-contain bg-logo-impact-investor-white theme-energeia:bg-logo-energeia theme-energeia:dark:bg-logo-energeia-darkmode theme-pensioen-pro:bg-logo-pensioen-pro theme-pensioen-pro:dark:bg-logo-pensioen-pro-darkmode theme-pensioen-pro:h-[34px] theme-energeia:h-[40px] theme-energeia:w-[141px] theme-pensioen-pro:w-[167px] w-[224px] h-[52px]"
							>
							</span>
						</a>

					</div>
					{% if feature_manager.is_enabled(constant('FEATURE_ENABLE_B_CORP_LOGO', feature_manager)) %}
						<div class="md:col-start-4">
							<a href="https://fdmg.nl/b-corp/" class="block svg:h-[90px] svg:w-auto text-secondary-700 dark:text-base-100" aria-label="{{ _x('B Corp logo, go to the B Corp page', 'Screen reader text', 'fdmg-labels') }}">
								{{ svg_icons.get('logo-b-corp')|raw }}
							</a>
						</div>
					{% endif %}
				</div>
			</div>
			<nav aria-labelledby="footer-heading">
				<h2 class="sr-only" id="footer-heading">{{ _x('Important links', 'Screen reader text', 'fdmg-labels') }}</h2>
				<div class="container">
					<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-4">
						{% if has_nav_menu(constant('ABOUT_NAV', navigation)) %}
							<div>
								<h3 class="mb-3 text-lg font-figtree text-secondary-700 dark:text-primary-300">{{ wp_get_nav_menu_name(constant('ABOUT_NAV', navigation))|raw }}</h3>
								{{ navigation.get_menu(constant('ABOUT_NAV', navigation), 'footer-nav', 1)|raw }}
							</div>
						{% endif %}
						{% if has_nav_menu(constant('GENERAL_NAV', navigation)) %}
							<div>
								<h3 class="mb-3 text-lg font-figtree text-secondary-700 dark:text-primary-300">{{ wp_get_nav_menu_name(constant('GENERAL_NAV', navigation))|raw }}</h3>
								{{ navigation.get_menu(constant('GENERAL_NAV', navigation), 'footer-nav', 1)|raw }}
							</div>
						{% endif %}
						{% if has_nav_menu(constant('SERVICES_NAV', navigation)) %}
							<div>
								<h3 class="mb-3 text-lg font-figtree text-secondary-700 dark:text-primary-300">{{ wp_get_nav_menu_name(constant('SERVICES_NAV', navigation))|raw }}</h3>
								{{ navigation.get_menu(constant('SERVICES_NAV', navigation), 'footer-nav', 1)|raw }}
							</div>
						{% endif %}
						{% if has_nav_menu(constant('FDMG_NAV', navigation)) %}
							<div>
								<h3 class="mb-3 text-lg font-figtree text-secondary-700 dark:text-primary-300">{{ wp_get_nav_menu_name(constant('FDMG_NAV', navigation))|raw }}</h3>
								{{ navigation.get_menu(constant('FDMG_NAV', navigation), 'footer-nav', 1)|raw }}
							</div>
						{% endif %}
					</div>

					{% if options.enable_sourcepoint_cmp %}
						<div class="mt-4">
							<button
								class="btn btn-link !text-secondary-700 dark:!text-base-50 hocus:underline"
								onclick="window._sp_.gdpr.loadPrivacyManagerModal({{ options.sourcepoint_options.sourcepoint_id|default(656244) }}, 'purposes')"
								aria-label="{{ _x('Privacy Settings, open cookie preference dialog', 'Screen reader text', 'fdmg-labels') }}"
							>
								{{ _x('Privacy Settings', 'Block', 'fdmg-labels') }}
							</button>
						</div>
					{% endif %}
				</div>
			</nav>
		</div>

		{% set socials = options.socials %}
		{% if socials %}
			<div class="py-6 border-t border-secondary-400 bg-secondary-300 dark:border-base-800 dark:bg-base-400 theme-energeia:bg-secondary-200 theme-pensioen-pro:bg-secondary-200 lg:py-9">
				<div class="container">
					<h3 class="mb-3 font-bold font-figtree text-md text-secondary-700 dark:text-primary-300 lg:text-lg">{{ _x('Follow us on social media', 'Social', 'fdmg-labels') }}</h3>

					{% include 'styleguide/components/social-media-links.twig' with {
						socials: socials,
					} %}
				</div>
			</div>
		{% endif %}

	</footer>
{{ wp_footer() }}
</body>
</html>
