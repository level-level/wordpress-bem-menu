{% extends 'layouts/sidebar-layout-with-header.twig' %}
{% set object = objects|first %}
{% set title = object.get_title() %}
{% set content = object.get_content() %}
{% set author_posts = object.get_current_paginated_posts() %}

{% set datalayer_config = {
	title: object.get_title(),
	page_category: 'team',
	page_type: 'team detail page',
}|json_encode(constant('JSON_HEX_QUOT')) %}

{% block header %}
	<div class="section" data-module="datalayer" data-type="pageview" data-config="{{ datalayer_config }}">
		<div class="container">
			<div class="w-full md:w-[calc(100%-theme(space.sidebar-width)-theme(space.5))]">
				{% include 'styleguide/components/author-header.twig' with {
					label: _x('Author', 'Label', 'fdmg-labels'),
					title: title,
				} %}
			</div>
		</div>
	</div>
{% endblock %}

{% block content %}

	{% if content %}
		<div class="section">
			<div class="entry-content">
				{{ content|raw }}
			</div>
		</div>
	{% endif %}

	{% if author_posts %}
		<div class="section">
			<h2 class="sr-only">
				{{ _x('Articles written by %s', 'Screen reader text', 'fdmg-labels')|format(title) }}
			</h2>
			<ul class="flex flex-col gap-3 sm:gap-6">
				{% for object in author_posts %}

					{% set image_id = object.get_thumbnail_id() %}
					{% set authors = object.get_authors() %}
					{% set revisions = wp_get_latest_revision_id_and_total_count(object.get_id()) %}

					{% if not feature_manager.is_enabled(constant('FEATURE_DISABLE_CATEGORY_TAXONOMY', feature_manager)) %}
						{% set categories = object.get_terms('category') %}
					{% endif %}

					{% if feature_manager.is_enabled(constant('FEATURE_ENABLE_GENRE_TAXONOMY', feature_manager)) %}
						{% set genres = object.get_terms('fdmg_genre') %}
					{% endif %}

					{% if feature_manager.is_enabled(constant('FEATURE_ENABLE_SECTION_TAXONOMY', feature_manager)) %}
						{% set sections = object.get_terms('fdmg_section') %}
					{% endif %}

					<li>
						{% include 'styleguide/components/teasers/teaser-post-wide.twig' with {
							image: image_id ? wp_get_attachment_image(image_id, 'thumbnail', false, {alt: ''}),
							title: object.get_title(),
							url: object.get_permalink(),
							excerpt: object.get_excerpt(),
							date: object.get_publish_date(),
							categories: categories ? categories|map(category => {
								name: category.get_name(),
							}),
							genres: genres ? genres|map(genre => {
								name: genre.get_name(),
							}),
							sections: sections ? sections|map(section => {
								name: section.get_name(),
							}),
							authors: authors ? authors|map(author => {
								name: author.get_title(),
								location: author.get_location(),
								url: author.get_permalink(),
							}),
							comments: object.get_comments_count(),
							useH3: true,
							show_paywall_label: not object.has_paywall_block() and feature_manager.is_enabled(constant('FEATURE_ENABLE_PAYWALL_LABEL', feature_manager)),
							article_id: object.get_id(),
							component_subtype: 'team',
							publication_date: object.get_date_i18n('Y-m-d'),
							publication_time: object.get_date_i18n('H:i'),
							revisions_count: revisions.count,
						} %}
					</li>
				{% endfor %}
			</ul>
		</div>

		{% include 'partials/components/pagination.twig' with {
			custom_args: object.get_current_pagination_args(),
		} %}
	{% endif %}
{% endblock %}

{% block sidebar %}
	<div class="section">
		{% set image_id = object.get_thumbnail_id() %}
		{% include 'styleguide/components/bio.twig' with {
			title: title,
			excerpt: object.get_excerpt(),
			image: image_id ? wp_get_attachment_image(image_id, 'thumbnail', false, {alt: ''}),
			email: object.get_email_address(),
			linkedin: object.get_linkedin(),
		} only %}
	</div>

	{% if is_active_sidebar('widget-area-author') %}
		{{ sidebar.get_widgetarea('widget-area-author')|raw }}
	{% endif %}
{% endblock %}
