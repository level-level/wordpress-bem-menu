{% extends 'layouts/sidebar-layout.twig' %}
{% set object = objects|first %}

{% block content %}
	<div class="section">
		{% include 'styleguide/components/article-header.twig' with {
			title: object.get_title(),
			label: __('Vacancy', 'fdmg-labels'),
		} %}

		<div class="entry-content">
			{{ object.get_content()|raw }}
		</div>
	</div>
{% endblock %}

{% block sidebar %}
	{% if is_active_sidebar('widget-area-vacancy') %}
		{{ sidebar.get_widgetarea('widget-area-vacancy')|raw }}
	{% endif %}
{% endblock %}
