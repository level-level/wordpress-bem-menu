{% extends 'layouts/sidebar-layout.twig' %}
{% set object = objects|first %}
{% set company_name = object.get_company_name() %}
{% set location = object.get_location() %}

{% block content %}
	<div class="section" {{ datalayer.get_config(object, 'PAGEVIEW') }}>
		{% include 'styleguide/components/article-header.twig' with {
			title: object.get_title(),
			label: _x('Vacancy', 'Label', 'fdmg-labels'),
		} %}

		{% if company_name or location %}
			<div class="mb-4">
				{% include 'styleguide/components/vacancy-metadata.twig' with {
					company_name: company_name,
					location: location,
				} %}
			</div>
		{% endif %}

		<div class="entry-content">
			{{ object.get_content()|raw }}
		</div>
	</div>
{% endblock %}

{% block sidebar %}
	{% if is_active_sidebar('widget-area-vacancy') %}
		{{ sidebar.get_widgetarea('widget-area-vacancy')|raw }}
	{% endif %}
{% endblock %}
