{% extends 'layouts/sidebar-layout.twig' %}
{% set object = objects|first %}

{% set datalayer_config = {
	title: archive_title,
	page_category: 'home',
	page_type: 'homepage',
	page_subtype: 'homepage',
}|json_encode(constant('JSON_HEX_QUOT')) %}

{% block content %}
	<h1 class="sr-only">{{ object.get_title()|raw }}</h1>
	<div class="section" data-module="datalayer" data-type="pageview" data-config="{{ datalayer_config }}">
		<div class="entry-content">
			{{ object.get_content()|raw }}
		</div>
	</div>
{% endblock %}

{% block sidebar %}
	{% if is_active_sidebar('widget-area-homepage') %}
		{{ sidebar.get_widgetarea('widget-area-homepage')|raw }}
	{% endif %}
{% endblock %}
