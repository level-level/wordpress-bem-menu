includes:
  - phpstan-baseline.neon
  - vendor/level-level/phpstan-config/config/wp-content.neon

parameters:
  checkGenericClassInNonGenericObjectType: false
  paths:
    - themes/fdmg-labels/app
  ignoreErrors:
    - '#Parameter \#2 \$callable of static method WP_CLI::add_command\(\) expects callable\(\): mixed, [a-zA-Z\\_'']+ given.#'
    - '#Used function WP_CLI\\Utils\\get_flag_value not found.#'
    -	'#Access to an undefined property [a-zA-Z_]+::\$[a-zA-Z]#'
    -	'#Call to an undefined method [a-zA-Z_]+::clarkson_render_callback\(\)#'
