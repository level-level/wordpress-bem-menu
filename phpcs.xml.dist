<?xml version="1.0"?>
<ruleset name="clarkson_core">
	<description>Level Level FDMG Labels ruleset</description>
	<config name="testVersion" value="8.0-"/>
	<file>./themes/fdmg-labels/app</file>
	<file>./themes/fdmg-labels/functions.php</file>
	<file>./tests/acceptance/</file>
	<file>./tests/functional/</file>
	<file>./tests/unit/</file>
	<file>./tests/wpunit/</file>
	<file>./post-autoload.php</file>

	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="LevelLevel"/>

</ruleset>
