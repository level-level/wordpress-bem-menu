<?xml version="1.0"?>
<ruleset name="clarkson_core">
	<description>Level Level Clarkson Theme dawn ruleset</description>
	<config name="testVersion" value="7.0-"/>
	<file>./themes/clarkson-theme-dawn/app</file>
	<file>./themes/clarkson-theme-dawn/functions.php</file>
	<file>./tests/acceptance/</file>
	<file>./tests/functional/</file>
	<file>./tests/unit/</file>
	<file>./tests/wpunit/</file>
	<file>./post-autoload.php</file>

	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="LevelLevel"/>
	<config name="testVersion" value="7.0-"/>

</ruleset>
