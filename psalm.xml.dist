<?xml version="1.0"?>
<psalm
    reportMixedIssues="true"
    autoloader="psalm-autoloader.php"
    errorLevel="2"
    hideExternalErrors="true"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorBaseline="psalm.baseline.xml"
>
    <projectFiles>
        <directory name="./themes/impact-investor/app" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <UndefinedClass>
            <errorLevel type="suppress">
                <referencedClass name="WP_CLI" />
                <referencedClass name="WP_CLI_Command" />
            </errorLevel>
        </UndefinedClass>
        <UndefinedFunction>
            <errorLevel type="suppress">
                <referencedFunction name="WP_CLI\Utils\format_items" />
                <referencedFunction name="WP_CLI\Utils\get_flag_value" />
            </errorLevel>
        </UndefinedFunction>
    </issueHandlers>
</psalm>
