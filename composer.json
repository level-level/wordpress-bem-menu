{
    "name": "level-level/impact-investor",
    "type": "project",
    "license": "proprietary",
    "description": "Level Level starter theme",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        },
        {
            "type": "composer",
            "url": "https://satis.level-level.com"
        },
        {
            "type": "git",
            "url": "https://github.com/level-level/Wordpress-Bem-Menu"
        }
    ],
    "autoload": {
        "psr-4":{
            "Hooks\\": "themes/impact-investor/app/Hooks",
            "Clarkson\\": "themes/impact-investor/app/Clarkson",
            "Gutenberg\\Blocks\\": "themes/impact-investor/app/Gutenberg/",
            "Clarkson_Core\\WordPress_Object\\": "themes/impact-investor/app/WordPress_Objects/",
            "ImpactInvestor\\": "themes/impact-investor/app/ImpactInvestor/"
        }
    },
    "require": {
        "level-level/ll-plugin-autoloader": "^3.0",
        "ll-premium/advanced-custom-fields-pro": "^5.12",
        "wpackagist-plugin/loco-translate": "^2.4",
        "wpackagist-plugin/disable-emojis": "^1.7",
        "level-level/wordpress-bem-menu": "^1.0",
        "wpackagist-plugin/wordfence": "^7.4",
        "wpackagist-plugin/post-smtp": "^2.0",
        "ext-mbstring": "^7.1",
        "level-level/clarkson-404": "^1.0",
        "level-level/logging": "^2.0",
        "wpackagist-plugin/wordpress-seo": "^18.0",
        "wpackagist-plugin/redirection": "^5.0",
        "level-level/clarkson-wp-cli-twig-translations": "^1.0",
        "level-level/clarkson-core": "^1.0",
        "ll-premium/searchwp": "^4.1",
        "wpackagist-plugin/koko-analytics": "^1.0",
        "wordplate/acf": "^11.2",
        "wpackagist-plugin/duracelltomi-google-tag-manager": "^1.14",
        "wpackagist-plugin/acf-content-analysis-for-yoast-seo": "^3.0",
        "ll-premium/gravityforms": "2.5.16.3",
        "wpackagist-plugin/popup-maker": "^1.16",
        "ll-premium/popup-maker-advanced-targeting-conditions": "^1.4"
    },
    "scripts": {
        "post-autoload-dump": [
            "cp ./vendor/level-level/ll-plugin-autoloader/0-loader.php ./mu-plugins/"
        ],
        "test": [
            "echo Running tests",
            "@test:composer",
            "@test:phpcs",
            "@test:psalm",
            "@test:twigcs",
            "@test:docs"
        ],
        "fix": [
            "phpcbf"
        ],
        "test:composer": [
            "composer validate"
        ],
        "test:phpcs": [
            "phpcs"
        ],
        "test:twigcs": [
            "twigcs themes/impact-investor/templates --severity error"
        ],
        "test:psalm": [
            "./vendor/bin/psalm.phar"
        ],
        "test:codeception": [
            "test ! -f codeception.yml && { echo NO LOCAL CONFIGURATION HAS BEEN SET UP. See README.md; exit 1; } || echo 'Local configuration found!'",
            "codecept run acceptance",
            "codecept run functional",
            "codecept run unit",
            "codecept run wpunit"
        ],
        "test:codeception:ci": [
            "codecept run acceptance",
            "codecept run functional",
            "codecept run unit",
            "codecept run wpunit"
        ],
        "test:docs": [
            "php-doc-check ./themes/impact-investor/app -x vendor"
        ],
        "make-pot": [
            "wp clarkson-twig-translations --require=vendor/level-level/clarkson-wp-cli-twig-translations/clarkson-wp-cli-twig-translations.php --template-dir=./themes/impact-investor/templates --output-dir=./themes/impact-investor/dist/rendered-templates",
            "wp i18n make-pot ./themes/impact-investor --path=./themes/impact-investor/ --slug=impact-investor",
            "wp i18n make-pot ./themes/impact-investor --path=./themes/impact-investor/ --slug=impact-investor-slugs --domain=impact-investor-slugs"
        ]
    },
    "extra": {
        "installer-paths": {
            "./mu-plugins/{$name}": [
                "type:wordpress-muplugin",
                "ll-premium/advanced-custom-fields-pro"
            ],
            "./plugins/{$name}": ["type:wordpress-plugin"],
            "./themes/{$name}": ["type:wordpress-theme"]
        }
    },
    "require-dev": {
        "niels-de-blaauw/php-doc-check": "^0.2.1",
        "wpackagist-plugin/user-switching": "^1.5",
        "level-level/coding-standards": "^1.0",
        "friendsoftwig/twigcs": "^5.0",
        "lucatume/wp-browser": "^3.0",
        "codeception/module-asserts": "^1.3",
        "codeception/module-phpbrowser": "^1.0",
        "codeception/module-webdriver": "^1.2",
        "codeception/module-db": "^1.1",
        "codeception/module-filesystem": "^1.0",
        "codeception/module-cli": "^1.1",
        "codeception/util-universalframework": "^1.0",
        "psalm/phar": "^4.11"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
