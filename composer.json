{
    "name": "level-level/fdmg-labels",
    "type": "project",
    "license": "proprietary",
    "description": "Level Level starter theme",
    "repositories": {
        "packagist.org": false,
        "private-packagist": {
            "type": "composer",
            "url": "https://repo.packagist.com/level-level/"
        },
        "0": {
            "type": "git",
            "url": "https://github.com/level-level/Wordpress-Bem-Menu"
        },
        "1": {
            "type": "path",
            "url": "themes/fdmg-labels/_generated/FDMGContentAPI"
        }
    },
    "autoload": {
        "psr-4": {
            "Hooks\\": "themes/fdmg-labels/app/Hooks",
            "Clarkson\\": "themes/fdmg-labels/app/Clarkson",
            "Gutenberg\\Blocks\\": "themes/fdmg-labels/app/Gutenberg/",
            "Clarkson_Core\\WordPress_Object\\": "themes/fdmg-labels/app/WordPress_Objects/",
            "FDMGLabels\\": "themes/fdmg-labels/app/FDMGLabels/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FDMGLabels\\Tests\\Helpers\\": [
                "tests/helpers"
            ],
            "FDMGLabels\\Tests\\": [
                "tests/wpunit/FDMGLabels"
            ],
            "FDMGLabels\\Tests\\Integration\\": [
                "tests/wpunit/FDMGLabels"
            ]
        }
    },
    "require": {
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "^7.1",
        "fdmg-labels/fdmg-content-api-client": "^1.4",
        "level-level/clarkson-404": "^1.0",
        "level-level/clarkson-core": "^1.0",
        "level-level/clarkson-wp-cli-twig-translations": "^1.0",
        "level-level/fdmg-server-side-tracking": "^1.2",
        "level-level/ll-paywall": "^1.0",
        "level-level/ll-plugin-autoloader": "^3.0",
        "level-level/logging": "^3.0",
        "level-level/wordpress-bem-menu": "^1.0",
        "level-level/wp-file-mods": "^1.0",
        "ll-premium/gravityforms": "^2.6",
        "ll-premium/gravityformspolls": "^4.0",
        "ll-premium/popup-maker-advanced-targeting-conditions": "^1.4",
        "ll-premium/popup-maker-exit-intent-popups": "^1.4",
        "ll-premium/searchwp": "^4.2",
        "ll-premium/wp-all-import-pro": "^4.7",
        "ll-premium/wpai-acf-add-on": "^3.3",
        "mentosmenno2/image-crop-positioner": "^0.6.0",
        "mhcg/monolog-wp-cli": "^1.0",
        "php-http/message-factory": "^1.1",
        "ramsey/uuid": "^4.7",
        "vinkla/extended-acf": "^13.3",
        "woocommerce/action-scheduler": "^3.6",
        "wpackagist-plugin/acf-content-analysis-for-yoast-seo": "^3.0",
        "wpackagist-plugin/daggerhart-openid-connect-generic": "^3.10",
        "wpackagist-plugin/debug-bar": "^1.1",
        "wpackagist-plugin/debug-bar-elasticpress": "^3.1",
        "wpackagist-plugin/disable-emojis": "^1.7",
        "wpackagist-plugin/download-monitor": "^4.9",
        "wpackagist-plugin/duracelltomi-google-tag-manager": "^1.16",
        "wpackagist-plugin/elasticpress": "^5.1",
        "wpackagist-plugin/koko-analytics": "^1.0",
        "wpackagist-plugin/loco-translate": "^2.4",
        "wpackagist-plugin/popup-maker": "^1.18",
        "wpackagist-plugin/post-smtp": "^2.9",
        "wpackagist-plugin/query-monitor": "^3.15",
        "wpackagist-plugin/redirection": "^5.3",
        "wpackagist-plugin/user-switching": "^1.7",
        "wpackagist-plugin/wordfence": "^7.8",
        "wpengine/advanced-custom-fields-pro": "^6.3",
        "yoast/wordpress-seo": "^23.2"
    },
    "scripts": {
        "post-autoload-dump": [
            "cp ./vendor/level-level/ll-plugin-autoloader/0-loader.php ./mu-plugins/"
        ],
        "test": [
            "echo Running tests",
            "@test:composer",
            "@test:phpcs",
            "@test:phpstan",
            "@test:twigcs",
            "@test:docs",
            "@test:openapi-spec"
        ],
        "fix": [
            "phpcbf"
        ],
        "test:composer": [
            "composer validate"
        ],
        "test:phpcs": [
            "phpcs"
        ],
        "test:twigcs": [
            "twigcs themes/fdmg-labels/templates --severity error"
        ],
        "test:psalm": [
            "echo Deprecated: use 'test:phpstan' instead.",
            "@test:phpstan"
        ],
        "test:phpstan": [
            "phpstan --memory-limit=2g"
        ],
        "test:codeception": [
            "test ! -f codeception.yml && { echo NO LOCAL CONFIGURATION HAS BEEN SET UP. See README.md; exit 1; } || echo 'Local configuration found!'",
            "codecept run acceptance",
            "codecept run functional",
            "codecept run unit",
            "codecept run wpunit"
        ],
        "test:codeception:ci": [
            "codecept run acceptance",
            "codecept run functional",
            "codecept run unit",
            "codecept run wpunit"
        ],
        "test:docs": [
            "php-doc-check ./themes/fdmg-labels/app -x vendor"
        ],
        "test:openapi-spec": [
            "php-openapi validate themes/fdmg-labels/docs/connections/fdmg-content-api/spec.yaml"
        ],
        "make-pot": [
            "wp clarkson-twig-translations --require=vendor/level-level/clarkson-wp-cli-twig-translations/clarkson-wp-cli-twig-translations.php --template-dir=./themes/fdmg-labels/templates --output-dir=./themes/fdmg-labels/dist/rendered-templates",
            "wp i18n make-pot ./themes/fdmg-labels --path=./themes/fdmg-labels/ --slug=fdmg-labels",
            "wp i18n make-pot ./themes/fdmg-labels --path=./themes/fdmg-labels/ --slug=fdmg-labels-slugs --domain=fdmg-labels-slugs",
            "wp i18n make-pot ./themes/fdmg-labels --path=./themes/fdmg-labels/ --slug=fdmg-labels-admin --domain=fdmg-labels-admin"
        ],
        "generate:fdmg-content-api": [
            "Composer\\Config::disableProcessTimeout",
            "sudo rm -rf themes/fdmg-labels/_generated/FDMGContentAPI",
            "mkdir -p themes/fdmg-labels/_generated/FDMGContentAPI",
            "FDMG_CONTENT_API_VERSION=$(cat themes/fdmg-labels/docs/connections/fdmg-content-api/spec.yaml | docker run --rm -i evns/yq --raw-output \".info.version\") && docker run --rm -v $PWD/:/local openapitools/openapi-generator-cli:v7.6.0 generate -i /local/themes/fdmg-labels/docs/connections/fdmg-content-api/spec.yaml -g php --additional-properties=invokerPackage=FDMGContentAPIClient --additional-properties=artifactVersion=$FDMG_CONTENT_API_VERSION --git-user-id=fdmg-labels --git-repo-id=fdmg-content-api-client -o /local/themes/fdmg-labels/_generated/FDMGContentAPI"
        ]
    },
    "extra": {
        "installer-paths": {
            "./mu-plugins/{$name}": [
                "type:wordpress-muplugin",
                "wpengine/advanced-custom-fields-pro"
            ],
            "./plugins/{$name}": [
                "type:wordpress-plugin"
            ],
            "./themes/{$name}": [
                "type:wordpress-theme"
            ]
        }
    },
    "require-dev": {
        "cebe/php-openapi": "^1.7",
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.0",
        "codeception/module-cli": "^2.0",
        "codeception/module-db": "^3.1",
        "codeception/module-filesystem": "^3.0",
        "codeception/module-phpbrowser": "^3.0",
        "codeception/module-webdriver": "^3.2",
        "codeception/util-universalframework": "^1.0",
        "friendsoftwig/twigcs": "^6.4",
        "level-level/coding-standards": "^4.0",
        "level-level/phpstan-config": "^1.0",
        "lucatume/wp-browser": "^4.2",
        "niels-de-blaauw/php-doc-check": "^0.4.0",
        "phpstan/extension-installer": "^1.1",
        "szepeviktor/phpstan-wordpress": "^1.1",
        "wp-cli/wp-cli-bundle": "^2.10"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
